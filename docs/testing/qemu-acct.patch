+usb_host_iso_ring_free(int bus, int addr, int ep, uint64_t accepted, uint64_t accepted_bytes, uint64_t refused, uint64_t pending) "dev %d:%d, ep %d, accepted %" PRIu64 ", accepted_bytes %" PRIu64 ", refused %" PRIu64 ", pending %" PRIu64 ""
