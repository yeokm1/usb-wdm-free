--- a/hw/usb/host-libusb.c
+++ b/hw/usb/host-libusb.c
@@ -151,6 +151,10 @@
     QTAILQ_HEAD(, USBHostIsoXfer)    inflight;
     QTAILQ_HEAD(, USBHostIsoXfer)    copy;
     QTAILQ_ENTRY(USBHostIsoRing)     next;
+    /* Observation only: guest packets taken by this ring, and refused. */
+    uint64_t                         accepted_packets;
+    uint64_t                         accepted_bytes;
+    uint64_t                         refused_packets;
 };
 
 static QTAILQ_HEAD(, USBHostDevice) hostdevs =
@@ -720,6 +724,16 @@
 static void usb_host_iso_free(USBHostIsoRing *ring)
 {
     USBHostIsoXfer *xfer;
+    uint64_t pending = 0;
+
+    /* Guest data still waiting in the copy queue is discarded below. */
+    QTAILQ_FOREACH(xfer, &ring->copy, next) {
+        pending += xfer->packet;
+    }
+    trace_usb_host_iso_ring_free(ring->host->bus_num, ring->host->addr,
+                                 ring->ep->nr, ring->accepted_packets,
+                                 ring->accepted_bytes, ring->refused_packets,
+                                 pending);
 
     while ((xfer = QTAILQ_FIRST(&ring->inflight)) != NULL) {
         QTAILQ_REMOVE(&ring->inflight, xfer, next);
@@ -854,12 +868,15 @@
         xfer = QTAILQ_FIRST(&ring->unused);
         if (xfer == NULL) {
             trace_usb_host_iso_out_of_bufs(s->bus_num, s->addr, p->ep->nr);
+            ring->refused_packets++;
             return;
         }
         QTAILQ_REMOVE(&ring->unused, xfer, next);
         usb_host_iso_reset_xfer(xfer);
         QTAILQ_INSERT_TAIL(&ring->copy, xfer, next);
     }
+    ring->accepted_packets++;
+    ring->accepted_bytes += p->iov.size;
     usb_host_iso_data_copy(xfer, p);
 
     if (QTAILQ_EMPTY(&ring->inflight)) {
