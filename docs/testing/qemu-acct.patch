+++ b/hw/usb/trace-events
@@ -343,6 +343,7 @@
 usb_host_iso_callback(int bus, int addr, int ep, void *transfer, int64_t ns, int status, int packets, int failed, int first, int actual) "dev %d:%d, ep %d, transfer %p, ns %" PRId64 ", status %d, packets %d, failed %d, first %d, actual %d"
 usb_host_iso_out_of_bufs(int bus, int addr, int ep) "dev %d:%d, ep %d"
