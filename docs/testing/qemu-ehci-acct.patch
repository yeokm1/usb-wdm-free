--- a/hw/usb/hcd-ehci.c
+++ b/hw/usb/hcd-ehci.c
@@ -722,6 +722,8 @@
     const char *owner = (*portsc & PORTSC_POWNER) ? "comp" : "ehci";
 
     trace_usb_ehci_port_detach(port->index, owner);
+    trace_usb_ehci_iso_out_summary(s->iso_out_ok, s->iso_out_ok_bytes,
+                                   s->iso_out_fail, s->iso_out_fail_bytes);
 
     if (*portsc & PORTSC_POWNER) {
         USBPort *companion = s->companion_ports[port->index];
@@ -1476,6 +1478,23 @@
                 }
             }
             qemu_sglist_destroy(&ehci->isgl);
+
+            /* Observation only: an OUT transaction that fails is reported to
+             * the guest as success (3.3.2), so its data loss is silent. */
+            if (!dir) {
+                if (ehci->ipacket.status == USB_RET_SUCCESS) {
+                    ehci->iso_out_ok++;
+                    ehci->iso_out_ok_bytes += len;
+                } else {
+                    ehci->iso_out_fail++;
+                    ehci->iso_out_fail_bytes += len;
+                    trace_usb_ehci_iso_out_fail(addr, i, ehci->ipacket.status, len);
+                }
+                if (!((ehci->iso_out_ok + ehci->iso_out_fail) % 8000)) {
+                    trace_usb_ehci_iso_out_summary(ehci->iso_out_ok, ehci->iso_out_ok_bytes,
+                                                   ehci->iso_out_fail, ehci->iso_out_fail_bytes);
+                }
+            }
 
             switch (ehci->ipacket.status) {
             case USB_RET_SUCCESS:
