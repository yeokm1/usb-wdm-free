diff --git a/hw/usb/host-libusb.c b/hw/usb/host-libusb.c
--- a/hw/usb/host-libusb.c
+++ b/hw/usb/host-libusb.c
@@ -519,16 +519,47 @@
 
 /* ------------------------------------------------------------------------ */
 
+static int usb_host_iso_submit(USBHostIsoXfer *xfer)
+{
+    int rc = libusb_submit_transfer(xfer->xfer);
+    USBHostDevice *s = xfer->ring->host;
+
+    trace_usb_host_iso_submit(s->bus_num, s->addr, xfer->ring->ep->nr,
+        xfer->xfer, qemu_clock_get_ns(QEMU_CLOCK_REALTIME),
+        xfer->xfer->num_iso_packets, xfer->xfer->length, rc);
+
+    return rc;
+}
+
 static void LIBUSB_CALL
 usb_host_req_complete_iso(struct libusb_transfer *transfer)
 {
     USBHostIsoXfer *xfer = transfer->user_data;
+
 
     if (!xfer) {
         /* USBHostIsoXfer released while inflight */
         g_free(transfer->buffer);
         libusb_free_transfer(transfer);
         return;
+    }
+
+    {
+        USBHostDevice *s = xfer->ring->host;
+        int i, failed = 0, first = 0, actual = 0;
+
+        for (i = 0; i < transfer->num_iso_packets; i++) {
+            actual += transfer->iso_packet_desc[i].actual_length;
+            if (transfer->iso_packet_desc[i].status != LIBUSB_TRANSFER_COMPLETED) {
+                if (!failed) {
+                    first = transfer->iso_packet_desc[i].status;
+                }
+                failed++;
+            }
+        }
+        trace_usb_host_iso_callback(s->bus_num, s->addr, xfer->ring->ep->nr,
+            transfer, qemu_clock_get_ns(QEMU_CLOCK_REALTIME), transfer->status,
+            transfer->num_iso_packets, failed, first, actual);
     }
 
     QTAILQ_REMOVE(&xfer->ring->inflight, xfer, next);
@@ -670,6 +701,7 @@
     return xfer->copy_complete;
 }
 
+
 static void usb_host_iso_data_in(USBHostDevice *s, USBPacket *p)
 {
     USBHostIsoRing *ring;
@@ -695,7 +727,7 @@
     while ((xfer = QTAILQ_FIRST(&ring->unused)) != NULL) {
         QTAILQ_REMOVE(&ring->unused, xfer, next);
         usb_host_iso_reset_xfer(xfer);
-        rc = libusb_submit_transfer(xfer->xfer);
+        rc = usb_host_iso_submit(xfer);
         if (rc != 0) {
             usb_host_libusb_error("libusb_submit_transfer [iso]", rc);
             QTAILQ_INSERT_TAIL(&ring->unused, xfer, next);
@@ -757,7 +789,7 @@
     while ((xfer = QTAILQ_FIRST(&ring->copy)) != NULL &&
            xfer->copy_complete) {
         QTAILQ_REMOVE(&ring->copy, xfer, next);
-        rc = libusb_submit_transfer(xfer->xfer);
+        rc = usb_host_iso_submit(xfer);
         if (rc != 0) {
             usb_host_libusb_error("libusb_submit_transfer [iso]", rc);
             QTAILQ_INSERT_TAIL(&ring->unused, xfer, next);
