-            if (transfer->iso_packet_desc[i].status != LIBUSB_TRANSFER_COMPLETED) {
-                if (!failed) {
-                    first = transfer->iso_packet_desc[i].status;
-                }
-                failed++;
-            }
-        }
+
         trace_usb_host_iso_callback(s->bus_num, s->addr, xfer->ring->ep->nr,
             transfer, qemu_clock_get_ns(QEMU_CLOCK_REALTIME), transfer->status,
             transfer->num_iso_packets, failed, first, actual);
