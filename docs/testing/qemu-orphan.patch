@@ -582,18 +582,45 @@
     return rc;
 }
 
+/* Observation only: summarize packet results for the ISO callback traces. */
+static void usb_host_iso_packet_summary(struct libusb_transfer *transfer,
+                                        int *failed, int *first, int *actual)
+{
+    int i;
+
+    *failed = *first = *actual = 0;
+    for (i = 0; i < transfer->num_iso_packets; i++) {
+        *actual += transfer->iso_packet_desc[i].actual_length;
+        if (transfer->iso_packet_desc[i].status != LIBUSB_TRANSFER_COMPLETED) {
+            if (!*failed) {
+                *first = transfer->iso_packet_desc[i].status;
+            }
+            (*failed)++;
+        }
+    }
+}
+
 static void LIBUSB_CALL
 usb_host_req_complete_iso(struct libusb_transfer *transfer)
 {
     USBHostIsoXfer *xfer = transfer->user_data;
+    int failed, first, actual;
 
 #ifdef CONFIG_WIN32
     assert(iso_request_count);
     iso_request_count--;
 #endif
 
+    usb_host_iso_packet_summary(transfer, &failed, &first, &actual);
     if (!xfer) {
-        /* USBHostIsoXfer released while inflight */
+        /*
+         * USBHostIsoXfer released while inflight. The ring (and so its
+         * device/endpoint) is gone; the transfer pointer pairs this
+         * completion with its earlier usb_host_iso_submit trace record.
+         */
+        trace_usb_host_iso_orphan_callback(transfer,
+            qemu_clock_get_ns(QEMU_CLOCK_REALTIME), transfer->status,
+            transfer->num_iso_packets, failed, first, actual);
         g_free(transfer->buffer);
         libusb_free_transfer(transfer);
         return;
