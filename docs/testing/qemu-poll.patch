+++ b/hw/usb/host-libusb.c
@@ -256,31 +256,56 @@
 
 #else
 
-static QEMUTimer *poll_timer;
+/* The libusb context and this notifier have process lifetime.  All normal
+ * dispatch stays on the main loop under BQL, and stops with the VM. */
 static uint32_t request_count;
 static uint32_t iso_request_count;
-
-static void usb_host_timer_kick(void)
-{
-    int64_t delay_ns;
-
-    delay_ns = iso_request_count
-        ? (NANOSECONDS_PER_SECOND / 1000) /* 1 ms for active ISO rings */
-        : request_count
-        ? (NANOSECONDS_PER_SECOND / 100)  /* 10 ms interval with active req */
-        : (NANOSECONDS_PER_SECOND);       /* 1 sec interval otherwise */
-    /* New work must not postpone an already earlier dispatch deadline.
-     * Keep VM-changing completion callbacks on the existing virtual clock. */
-    timer_mod_anticipate_ns(poll_timer,
-        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + delay_ns);
-}
-
-static void usb_host_timer(void *opaque)
-{
+static Notifier usb_host_poll_notifier;
+static VMChangeStateEntry *usb_host_poll_vmstate;
+static bool usb_host_poll_dispatching;
+
+static void usb_host_poll_kick(void)
+{
+    /* A request may arrive while an earlier idle host wait is in progress. */
+    qemu_notify_event();
+}
+
+static void usb_host_poll_notify(Notifier *notifier, void *data)
+{
+    MainLoopPoll *poll = data;
     struct timeval tv = { 0, 0 };
-
-    libusb_handle_events_timeout(ctx, &tv);
-    usb_host_timer_kick();
+    uint32_t delay_ms;
+
+    (void)notifier;
+    assert(bql_locked());
+    if (!runstate_is_running()) {
+        return;
+    }
+    switch (poll->state) {
+    case MAIN_LOOP_POLL_FILL:
+        delay_ms = (request_count || iso_request_count) ? 1 : 1000;
+        poll->timeout = MIN(poll->timeout, delay_ms);
+        break;
+    case MAIN_LOOP_POLL_OK:
+    case MAIN_LOOP_POLL_ERR:
+        if (!usb_host_poll_dispatching) {
+            usb_host_poll_dispatching = true;
+            libusb_handle_events_timeout(ctx, &tv);
+            usb_host_poll_dispatching = false;
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static void usb_host_poll_vm_change(void *opaque, bool running, RunState state)
+{
+    (void)opaque;
+    (void)state;
+    if (running) {
+        usb_host_poll_kick();
+    }
 }
 
 #endif /* !CONFIG_WIN32 */
