+/*
+ * USB printer class device (USB Device Class Definition for Printing
+ * Devices 1.1), test-only model.
+ *
+ * Interface 07/01/02 (bidirectional: bulk OUT 0x01, bulk IN 0x82) or, with
+ * protocol=1, 07/01/01 (bulk OUT only).  It answers the three class
+ * requests of the specification's section 4.2:
+ *   GET_DEVICE_ID   (A1h, 0): 2-byte big-endian length, then the IEEE 1284
+ *                             device id from the "device-id" property;
+ *   GET_PORT_STATUS (A1h, 1): one byte, bit 5 Paper Empty, bit 4 Select,
+ *                             bit 3 Not Error (Table 3);
+ *   SOFT_RESET      (21h, 2): also accepted as 23h, the 1.0 code that
+ *                             section 4.2.3 tells hosts to expect.
+ * Bulk OUT is written to the host file named by "file".  Bulk IN returns
+ * queued bytes and NAKs when none are queued.  Bytes are queued by a PJL
+ * "@PJL INFO STATUS" in the OUT stream (a status reply built from the
+ * status bits) and by writing the "in-inject" property.
+ *
+ * Status properties, settable at run time with qom-set: paper-empty,
+ * error, offline, busy.  While paper-empty, error or offline is set (and
+ * hold-on-fault is on, the default) or busy is set, bulk OUT is NAKed, as
+ * a printer that has stopped taking data.  out-rate (bytes per second)
+ * paces bulk OUT so that a job takes long enough to be interrupted.
+ *
+ * Copyright (C) 2026 Yeo Kheng Meng
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/cutils.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/usb/usb.h"
+#include "migration/vmstate.h"
+#include "desc.h"
+#include "qom/object.h"
+
+#define PRN_GET_DEVICE_ID       0
+#define PRN_GET_PORT_STATUS     1
+#define PRN_SOFT_RESET          2
+
+/* SOFT_RESET as printer class 1.0 had it: recipient Other */
+#define ClassOtherOutRequest \
+        ((USB_DIR_OUT | USB_TYPE_CLASS | USB_RECIP_OTHER) << 8)
+
+#define PRN_ST_PAPER_EMPTY      0x20
+#define PRN_ST_SELECT           0x10
+#define PRN_ST_NOT_ERROR        0x08
+
+#define PRN_ID_MAX              1023    /* id bytes; +2 length bytes */
+#define PRN_IN_MAX              4096
+
+#define PRN_DEFAULT_ID \
+    "MFG:Hewlett-Packard;CMD:PJL,PCL;MDL:HP LaserJet 4000 Series;" \
+    "CLS:PRINTER;DES:Hewlett-Packard HP LaserJet 4000 Series;"
+
+struct USBPrinterState {
+    USBDevice dev;
+
+    /* properties */
+    char *device_id;
+    char *file;
+    char *log;
+    uint8_t protocol;
+    bool highspeed;
+    bool append;
+    bool reset_other_only;
+    bool hold_on_fault;
+    uint16_t usb_vid;
+    uint16_t usb_pid;
+    uint32_t out_rate;
+
+    /* run-time status (QOM properties) */
+    bool paper_empty;
+    bool error;
+    bool offline;
+    bool busy;
+
+    USBDesc own_desc;
+    USBEndpoint *ep_out;
+    USBEndpoint *ep_in;
+    FILE *sink;
+    FILE *logf;
+    uint64_t out_total;
+    uint64_t out_naks;
+    bool nak_logged;
+    int64_t next_ok_ns;
+    QEMUTimer *pace;
+
+    uint8_t inq[PRN_IN_MAX];
+    uint32_t inq_len;
+    uint32_t match;             /* chars of "@PJL INFO STATUS" matched */
+    bool zlp_due;               /* last IN data ended on a full packet */
+    bool sink_failed;           /* the host file could not be written */
+};
+
+#define TYPE_USB_PRINTER "usb-printer"
+OBJECT_DECLARE_SIMPLE_TYPE(USBPrinterState, USB_PRINTER)
+
+static const char pjl_info_status[] = "@PJL INFO STATUS";
+
+enum {
+    STR_MANUFACTURER = 1,
+    STR_PRODUCT,
+    STR_SERIALNUMBER,
+};
+
+static const USBDescStrings desc_strings = {
+    [STR_MANUFACTURER]  = "QEMU",
+    [STR_PRODUCT]       = "QEMU USB Printer",
+    [STR_SERIALNUMBER]  = "1",
+};
+
+#define PRN_IFACE(name_, proto_, neps_, mps_)                           \
+static const USBDescIface name_ = {                                     \
+    .bInterfaceNumber              = 0,                                 \
+    .bNumEndpoints                 = (neps_),                           \
+    .bInterfaceClass               = 0x07,                              \
+    .bInterfaceSubClass            = 0x01,                              \
+    .bInterfaceProtocol            = (proto_),                          \
+    .eps = (USBDescEndpoint[]) {                                        \
+        {                                                               \
+            .bEndpointAddress      = USB_DIR_OUT | 0x01,                \
+            .bmAttributes          = USB_ENDPOINT_XFER_BULK,            \
+            .wMaxPacketSize        = (mps_),                            \
+        }, {                                                            \
+            .bEndpointAddress      = USB_DIR_IN | 0x02,                 \
+            .bmAttributes          = USB_ENDPOINT_XFER_BULK,            \
+            .wMaxPacketSize        = (mps_),                            \
+        },                                                              \
+    },                                                                  \
+}
+
+PRN_IFACE(iface_bidi_fs, 0x02, 2, 64);
+PRN_IFACE(iface_bidi_hs, 0x02, 2, 512);
+PRN_IFACE(iface_uni_fs, 0x01, 1, 64);
+PRN_IFACE(iface_uni_hs, 0x01, 1, 512);
+
+#define PRN_DEVICE(name_, bcd_, mp0_, iface_)                           \
+static const USBDescDevice name_ = {                                    \
+    .bcdUSB                        = (bcd_),                            \
+    .bMaxPacketSize0               = (mp0_),                            \
+    .bNumConfigurations            = 1,                                 \
+    .confs = (USBDescConfig[]) {                                        \
+        {                                                               \
+            .bNumInterfaces        = 1,                                 \
+            .bConfigurationValue   = 1,                                 \
+            .bmAttributes          = USB_CFG_ATT_ONE | USB_CFG_ATT_SELFPOWER, \
+            .bMaxPower             = 1,                                 \
+            .nif = 1,                                                   \
+            .ifs = &(iface_),                                           \
+        },                                                              \
+    },                                                                  \
+}
+
+PRN_DEVICE(dev_bidi_fs, 0x0110, 64, iface_bidi_fs);
+PRN_DEVICE(dev_bidi_fs2, 0x0200, 64, iface_bidi_fs);
+PRN_DEVICE(dev_bidi_hs, 0x0200, 64, iface_bidi_hs);
+PRN_DEVICE(dev_uni_fs, 0x0110, 64, iface_uni_fs);
+PRN_DEVICE(dev_uni_fs2, 0x0200, 64, iface_uni_fs);
+PRN_DEVICE(dev_uni_hs, 0x0200, 64, iface_uni_hs);
+
+static const USBDesc desc_printer = {
+    .id = {
+        .idVendor          = 0x46f4,
+        .idProduct         = 0x0010,
+        .bcdDevice         = 0x0100,
+        .iManufacturer     = STR_MANUFACTURER,
+        .iProduct          = STR_PRODUCT,
+        .iSerialNumber     = STR_SERIALNUMBER,
+    },
+    .full = &dev_bidi_fs,
+    .str  = desc_strings,
+};
+
+static void prn_log(USBPrinterState *s, const char *fmt, ...)
+    G_GNUC_PRINTF(2, 3);
+
+static void prn_log(USBPrinterState *s, const char *fmt, ...)
+{
+    va_list ap;
+
+    if (!s->logf) {
+        return;
+    }
+    fprintf(s->logf, "%" PRId64 " ",
+            qemu_clock_get_ms(QEMU_CLOCK_REALTIME));
+    va_start(ap, fmt);
+    vfprintf(s->logf, fmt, ap);
+    va_end(ap);
+    fputc('\n', s->logf);
+    fflush(s->logf);
+}
+
+static uint8_t prn_status(USBPrinterState *s)
+{
+    uint8_t st = 0;
+
+    if (s->paper_empty) {
+        st |= PRN_ST_PAPER_EMPTY;
+    }
+    if (!s->offline) {
+        st |= PRN_ST_SELECT;
+    }
+    if (!s->error) {
+        st |= PRN_ST_NOT_ERROR;
+    }
+    return st;
+}
+
+static bool prn_out_held(USBPrinterState *s)
+{
+    if (s->busy) {
+        return true;
+    }
+    return s->hold_on_fault && (s->paper_empty || s->error || s->offline);
+}
+
+static void prn_wake(USBPrinterState *s)
+{
+    if (!s->dev.attached) {
+        return;
+    }
+    if (s->ep_out) {
+        usb_wakeup(s->ep_out, 0);
+    }
+    if (s->ep_in && s->inq_len) {
+        usb_wakeup(s->ep_in, 0);
+    }
+}
+
+static void prn_queue(USBPrinterState *s, const void *buf, size_t len)
+{
+    size_t room = PRN_IN_MAX - s->inq_len;
+
+    if (len > room) {
+        prn_log(s, "IN queue full, %zu bytes dropped", len - room);
+        len = room;
+    }
+    memcpy(s->inq + s->inq_len, buf, len);
+    s->inq_len += len;
+    if (len && s->dev.attached && s->ep_in) {
+        usb_wakeup(s->ep_in, 0);
+    }
+}
+
+/* PJL status reply (PJL INFO STATUS form); codes 10001 ready online,
+ * 10002 offline, 41000 paper out, 40000 other error, as this model's own
+ * choice within PJL's status-code groups. */
+static void prn_pjl_status(USBPrinterState *s)
+{
+    const char *code, *disp, *online;
+    char *r;
+
+    if (s->paper_empty) {
+        code = "41000";
+        disp = "PAPER OUT";
+    } else if (s->error) {
+        code = "40000";
+        disp = "ERROR";
+    } else if (s->offline) {
+        code = "10002";
+        disp = "OFFLINE";
+    } else {
+        code = "10001";
+        disp = "00 READY";
+    }
+    online = (s->offline || s->error) ? "FALSE" : "TRUE";
+    r = g_strdup_printf("@PJL INFO STATUS\r\nCODE=%s\r\nDISPLAY=\"%s\"\r\n"
+                        "ONLINE=%s\r\n\f", code, disp, online);
+    prn_log(s, "PJL INFO STATUS -> CODE=%s", code);
+    prn_queue(s, r, strlen(r));
+    g_free(r);
+}
+
+static void prn_scan(USBPrinterState *s, const uint8_t *p, size_t n)
+{
+    size_t i;
+    const size_t nl = sizeof(pjl_info_status) - 1;
+
+    for (i = 0; i < n; i++) {
+        if (p[i] == (uint8_t)pjl_info_status[s->match]) {
+            if (++s->match == nl) {
+                s->match = 0;
+                prn_pjl_status(s);
+            }
+        } else {
+            s->match = (p[i] == (uint8_t)pjl_info_status[0]) ? 1 : 0;
+        }
+    }
+}
+
+static void prn_pace_cb(void *opaque)
+{
+    USBPrinterState *s = opaque;
+
+    if (s->dev.attached && s->ep_out) {
+        usb_wakeup(s->ep_out, 0);
+    }
+}
+
+static void usb_printer_handle_reset(USBDevice *dev)
+{
+    USBPrinterState *s = USB_PRINTER(dev);
+
+    s->inq_len = 0;
+    s->match = 0;
+    s->zlp_due = false;
+    prn_log(s, "bus reset");
+}
+
+static void usb_printer_handle_control(USBDevice *dev, USBPacket *p,
+                                       int request, int value, int index,
+                                       int length, uint8_t *data)
+{
+    USBPrinterState *s = USB_PRINTER(dev);
+    size_t idlen;
+    int n;
+
+    if (usb_desc_handle_control(dev, p, request, value, index, length,
+                                data) >= 0) {
+        return;
+    }
+
+    switch (request) {
+    case EndpointOutRequest | USB_REQ_CLEAR_FEATURE:
+        prn_log(s, "CLEAR_FEATURE endpoint 0x%02x", index & 0xff);
+        break;
+
+    case ClassInterfaceRequest | PRN_GET_DEVICE_ID:
+        /* wIndex: interface in the high byte, alternate in the low byte;
+         * interface 0 alternate 0 is 0 in either layout. */
+        if ((index >> 8) != 0 || (index & 0xff) != 0 || value != 0) {
+            prn_log(s, "GET_DEVICE_ID wValue=%d wIndex=0x%04x: stall",
+                    value, index);
+            p->status = USB_RET_STALL;
+            break;
+        }
+        idlen = strlen(s->device_id);
+        if (idlen > PRN_ID_MAX) {
+            idlen = PRN_ID_MAX;
+        }
+        {
+            uint8_t buf[PRN_ID_MAX + 2];
+
+            buf[0] = (uint8_t)((idlen + 2) >> 8);
+            buf[1] = (uint8_t)(idlen + 2);
+            memcpy(buf + 2, s->device_id, idlen);
+            n = MIN(length, (int)idlen + 2);
+            memcpy(data, buf, n);
+            p->actual_length = n;
+        }
+        prn_log(s, "GET_DEVICE_ID wLength=%d -> %d of %zu", length, n,
+                idlen + 2);
+        break;
+
+    case ClassInterfaceRequest | PRN_GET_PORT_STATUS:
+        if (index != 0 || length < 1) {
+            p->status = USB_RET_STALL;
+            break;
+        }
+        data[0] = prn_status(s);
+        p->actual_length = 1;
+        prn_log(s, "GET_PORT_STATUS -> 0x%02x", data[0]);
+        break;
+
+    case ClassInterfaceOutRequest | PRN_SOFT_RESET:
+        if (s->reset_other_only) {
+            prn_log(s, "SOFT_RESET 21h: stall (reset-other-only)");
+            p->status = USB_RET_STALL;
+            break;
+        }
+        /* fall through */
+    case ClassOtherOutRequest | PRN_SOFT_RESET:
+        s->inq_len = 0;
+        s->match = 0;
+        s->zlp_due = false;
+        prn_log(s, "SOFT_RESET %02xh", (request >> 8) & 0xff);
+        break;
+
+    default:
+        prn_log(s, "unsupported control 0x%04x wValue=%d wIndex=%d: stall",
+                request, value, index);
+        p->status = USB_RET_STALL;
+        break;
+    }
+}
+
+static void prn_out(USBPrinterState *s, USBPacket *p)
+{
+    size_t len = p->iov.size;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    g_autofree uint8_t *buf = NULL;
+
+    if (prn_out_held(s)) {
+        s->out_naks++;
+        if (!s->nak_logged) {
+            prn_log(s, "OUT held (status 0x%02x busy %d)", prn_status(s),
+                    s->busy);
+            s->nak_logged = true;
+        }
+        p->status = USB_RET_NAK;
+        return;
+    }
+    if (s->out_rate && now < s->next_ok_ns) {
+        timer_mod_ns(s->pace, s->next_ok_ns);
+        p->status = USB_RET_NAK;
+        return;
+    }
+    if (s->nak_logged) {
+        prn_log(s, "OUT resumed after %" PRIu64 " NAKs", s->out_naks);
+        s->nak_logged = false;
+        s->out_naks = 0;
+    }
+    if (s->sink_failed) {
+        p->status = USB_RET_STALL;
+        return;
+    }
+    buf = g_malloc(len ? len : 1);
+    usb_packet_copy(p, buf, len);
+    if (s->sink && len) {
+        if (fwrite(buf, 1, len, s->sink) != len || fflush(s->sink) != 0) {
+            /* data the file did not take is never acknowledged: the OUT
+             * endpoint stalls from here on */
+            s->sink_failed = true;
+            prn_log(s, "file write failed: OUT stalls from now on");
+            error_report("usb-printer: cannot write %s; bulk OUT stalls",
+                         s->file);
+            p->actual_length = 0;   /* nothing of it was taken */
+            p->status = USB_RET_STALL;
+            return;
+        }
+    }
+    s->out_total += len;
+    if (s->out_rate) {
+        s->next_ok_ns = now + (int64_t)len * NANOSECONDS_PER_SECOND /
+                        s->out_rate;
+    }
+    prn_log(s, "OUT %zu total %" PRIu64, len, s->out_total);
+    prn_scan(s, buf, len);
+}
+
+static void prn_in(USBPrinterState *s, USBPacket *p)
+{
+    size_t n;
+
+    if (!s->inq_len) {
+        if (s->zlp_due) {
+            /* the reply ended on a full packet: end the transfer */
+            s->zlp_due = false;
+            prn_log(s, "IN zero-length");
+            return;
+        }
+        p->status = USB_RET_NAK;
+        return;
+    }
+    n = MIN(p->iov.size, (size_t)s->inq_len);
+    usb_packet_copy(p, s->inq, n);
+    memmove(s->inq, s->inq + n, s->inq_len - n);
+    s->inq_len -= n;
+    /* Only a reply that filled the whole packet on a packet boundary
+     * leaves the host waiting; a shorter one ended the transfer itself. */
+    s->zlp_due = s->inq_len == 0 && n == p->iov.size &&
+                 p->ep->max_packet_size > 0 &&
+                 n % p->ep->max_packet_size == 0;
+    prn_log(s, "IN %zu left %u", n, s->inq_len);
+}
+
+static void usb_printer_handle_data(USBDevice *dev, USBPacket *p)
+{
+    USBPrinterState *s = USB_PRINTER(dev);
+
+    if (p->pid == USB_TOKEN_OUT && p->ep->nr == 1) {
+        prn_out(s, p);
+    } else if (p->pid == USB_TOKEN_IN && p->ep->nr == 2 &&
+               s->protocol == 2) {
+        prn_in(s, p);
+    } else {
+        p->status = USB_RET_STALL;
+    }
+}
+
+static void usb_printer_realize(USBDevice *dev, Error **errp)
+{
+    USBPrinterState *s = USB_PRINTER(dev);
+
+    if (s->protocol != 1 && s->protocol != 2) {
+        error_setg(errp, "protocol must be 1 or 2");
+        return;
+    }
+    if (!s->device_id) {
+        s->device_id = g_strdup(PRN_DEFAULT_ID);
+    }
+    s->own_desc = desc_printer;
+    if (s->usb_vid) {
+        s->own_desc.id.idVendor = s->usb_vid;
+    }
+    if (s->usb_pid) {
+        s->own_desc.id.idProduct = s->usb_pid;
+    }
+    if (s->highspeed) {
+        s->own_desc.full = s->protocol == 2 ? &dev_bidi_fs2 : &dev_uni_fs2;
+        s->own_desc.high = s->protocol == 2 ? &dev_bidi_hs : &dev_uni_hs;
+    } else {
+        s->own_desc.full = s->protocol == 2 ? &dev_bidi_fs : &dev_uni_fs;
+    }
+    dev->usb_desc = &s->own_desc;
+
+    if (s->file) {
+        s->sink = fopen(s->file, s->append ? "ab" : "wb");
+        if (!s->sink) {
+            error_setg_errno(errp, errno, "cannot open %s", s->file);
+            return;
+        }
+    }
+    if (s->log) {
+        s->logf = fopen(s->log, "a");
+        if (!s->logf) {
+            error_setg_errno(errp, errno, "cannot open %s", s->log);
+            if (s->sink) {
+                fclose(s->sink);
+                s->sink = NULL;
+            }
+            return;
+        }
+    }
+    usb_desc_create_serial(dev);
+    usb_desc_init(dev);
+    s->ep_out = usb_ep_get(dev, USB_TOKEN_OUT, 1);
+    s->ep_in = s->protocol == 2 ? usb_ep_get(dev, USB_TOKEN_IN, 2) : NULL;
+    s->pace = timer_new_ns(QEMU_CLOCK_VIRTUAL, prn_pace_cb, s);
+    prn_log(s, "realize protocol %u %s id \"%s\"", s->protocol,
+            s->highspeed ? "high+full" : "full", s->device_id);
+}
+
+static void usb_printer_unrealize(USBDevice *dev)
+{
+    USBPrinterState *s = USB_PRINTER(dev);
+
+    prn_log(s, "unrealize, %" PRIu64 " bytes received", s->out_total);
+    if (s->pace) {
+        timer_free(s->pace);
+        s->pace = NULL;
+    }
+    if (s->sink) {
+        fclose(s->sink);
+        s->sink = NULL;
+    }
+    if (s->logf) {
+        fclose(s->logf);
+        s->logf = NULL;
+    }
+}
+
