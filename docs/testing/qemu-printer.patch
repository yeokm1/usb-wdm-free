+/*
+ * QTest testcase for the usb-printer device (USB printer class 1.1 model):
+ * descriptors, the three class requests, the status properties, bulk OUT
+ * into the host file (held while a fault is raised), and bulk IN replies.
+ *
+ * A minimal xHCI driver on qemu-xhci, as usb-hcd-xhci-ring-test.c.
+ *
+ * Copyright (C) 2026 Yeo Kheng Meng
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "libqos/pci-pc.h"
+#include "qobject/qdict.h"
+
+#define DCBAA       0x01000000ULL
+#define CMD_RING    0x01001000ULL
+#define EVT_RING    0x01002000ULL
+#define ERST        0x01003000ULL
+#define IN_CTX      0x01004000ULL
+#define OUT_CTX     0x01005000ULL
+#define EP0_RING    0x01006000ULL
+#define OUT_RING    0x01007000ULL
+#define IN_RING     0x01008000ULL
+#define DATA_BUF    0x01009000ULL
+
+#define RING_TRBS   64
+#define EVT_TRBS    64
+
+#define T_NORMAL    1
+#define T_SETUP     2
+#define T_DATA      3
+#define T_STATUS    4
+#define T_EN_SLOT   9
+#define T_ADDR_DEV  11
+#define T_CFG_EP    12
+#define T_EV_XFER   32
+#define T_EV_CMD    33
+
+#define CC_SUCCESS  1
+#define CC_STALL    6
+#define CC_SHORT    13
+
+#define OUT_DCI     2       /* endpoint 0x01 */
+#define IN_DCI      5       /* endpoint 0x82 */
+
+typedef struct {
+    QTestState *qts;
+    QPCIBus *bus;
+    QPCIDevice *dev;
+    QPCIBar bar;
+    uint32_t op, rt, db;
+    uint32_t cmd_idx, evt_idx, ep0_idx, out_idx, in_idx;
+    bool evt_ccs;
+    uint32_t slot;
+    uint32_t portsc;
+    uint32_t port;
+    char *file;
+} PrnT;
+
+typedef struct {
+    uint64_t ptr;
+    uint32_t status;
+    uint32_t control;
+} Evt;
+
+static uint32_t rd32(PrnT *x, uint32_t off)
+{
+    return qpci_io_readl(x->dev, x->bar, off);
+}
+
+static void wr32(PrnT *x, uint32_t off, uint32_t v)
+{
+    qpci_io_writel(x->dev, x->bar, off, v);
+}
+
+static void wr64(PrnT *x, uint32_t off, uint64_t v)
+{
+    qpci_io_writel(x->dev, x->bar, off, (uint32_t)v);
+    qpci_io_writel(x->dev, x->bar, off + 4, (uint32_t)(v >> 32));
+}
+
+static void put_trb(PrnT *x, uint64_t at, uint64_t param, uint32_t status,
+                    uint32_t control)
+{
+    qtest_writeq(x->qts, at, param);
+    qtest_writel(x->qts, at + 8, status);
+    qtest_writel(x->qts, at + 12, control);
+}
+
+static bool get_evt(PrnT *x, Evt *e)
+{
+    uint64_t at = EVT_RING + 16ULL * x->evt_idx;
+    uint32_t control = qtest_readl(x->qts, at + 12);
+
+    if ((control & 1) != x->evt_ccs) {
+        return false;
+    }
+    e->ptr = qtest_readq(x->qts, at);
+    e->status = qtest_readl(x->qts, at + 8);
+    e->control = control;
+    if (++x->evt_idx == EVT_TRBS) {
+        x->evt_idx = 0;
+        x->evt_ccs = !x->evt_ccs;
+    }
+    wr64(x, x->rt + 0x20 + 0x18, (EVT_RING + 16ULL * x->evt_idx) | 8);
+    return true;
+}
+
+static bool wait_evt(PrnT *x, Evt *e)
+{
+    int i;
+
+    for (i = 0; i < 200; i++) {
+        if (get_evt(x, e)) {
+            return true;
+        }
+        qtest_clock_step(x->qts, 1000 * 1000);
+    }
+    return false;
+}
+
+static int evt_cc(const Evt *e)
+{
+    return e->status >> 24;
+}
+
+static int evt_type(const Evt *e)
+{
+    return (e->control >> 10) & 0x3f;
+}
+
+static Evt cmd(PrnT *x, uint64_t param, uint32_t control)
+{
+    Evt e;
+
+    put_trb(x, CMD_RING + 16ULL * x->cmd_idx, param, 0, control | 1);
+    x->cmd_idx++;
+    g_assert_cmpuint(x->cmd_idx, <, 15);
+    wr32(x, x->db, 0);
+    do {
+        g_assert_true(wait_evt(x, &e));
+    } while (evt_type(&e) != T_EV_CMD);
+    return e;
+}
+
+static void ctx_clear(PrnT *x, uint64_t at)
+{
+    int i;
+
+    for (i = 0; i < 0x440; i += 4) {
+        qtest_writel(x->qts, at + i, 0);
+    }
+}
+
+/*
+ * A control transfer on EP0.  IN data lands in buf (up to wlen bytes);
+ * returns the completion code of the last stage that failed, or
+ * CC_SUCCESS, with *actual the bytes of the data stage.
+ */
+static int ctrl(PrnT *x, uint8_t bmrt, uint8_t breq, uint16_t wval,
+                uint16_t widx, uint16_t wlen, uint8_t *buf, int *actual)
+{
+    uint64_t setup = bmrt | ((uint64_t)breq << 8) | ((uint64_t)wval << 16) |
+                     ((uint64_t)widx << 32) | ((uint64_t)wlen << 48);
+    bool in = (bmrt & 0x80) != 0;
+    uint64_t status_at;
+    int cc = CC_SUCCESS, got = 0;
+    Evt e;
+
+    g_assert_cmpuint(x->ep0_idx + 3, <, RING_TRBS);
+    put_trb(x, EP0_RING + 16ULL * x->ep0_idx++, setup, 8,
+            (T_SETUP << 10) | (1 << 6) |
+            ((wlen ? (in ? 3 : 2) : 0) << 16) | 1);
+    if (wlen) {
+        put_trb(x, EP0_RING + 16ULL * x->ep0_idx++, DATA_BUF, wlen,
+                (T_DATA << 10) | ((in ? 1 : 0) << 16) | (1 << 5) |
+                (1 << 2) | 1);
+    }
+    status_at = EP0_RING + 16ULL * x->ep0_idx++;
+    put_trb(x, status_at, 0, 0, (T_STATUS << 10) |
+            ((wlen && in ? 0 : 1) << 16) | (1 << 5) | 1);
+    wr32(x, x->db + 4 * x->slot, 1);
+    for (;;) {
+        g_assert_true(wait_evt(x, &e));
+        g_assert_cmpint(evt_type(&e), ==, T_EV_XFER);
+        if (evt_cc(&e) == CC_STALL) {
+            cc = CC_STALL;
+            break;
+        }
+        if (e.ptr == status_at) {
+            g_assert_cmpint(evt_cc(&e), ==, CC_SUCCESS);
+            break;
+        }
+        g_assert_true(evt_cc(&e) == CC_SUCCESS || evt_cc(&e) == CC_SHORT);
+        got = wlen - (e.status & 0xffffff);
+    }
+    if (buf && got) {
+        qtest_memread(x->qts, DATA_BUF, buf, got);
+    }
+    if (actual) {
+        *actual = got;
+    }
+    return cc;
+}
+
+static void prn_bringup(PrnT *x, const char *props)
+{
+    uint32_t caplen, nports, i, portsc = 0, port = 0;
+    Evt e;
+    int fd;
+    GError *err = NULL;
+
+    memset(x, 0, sizeof(*x));
+    fd = g_file_open_tmp("usb-printer-XXXXXX.prn", &x->file, &err);
+    g_assert_no_error(err);
+    close(fd);
+    x->qts = qtest_initf("-machine pc -m 128 "
+                         "-device qemu-xhci,id=xhci,addr=04.0 "
+                         "-device usb-printer,id=prn,bus=xhci.0,file=%s%s%s",
+                         x->file, props ? "," : "", props ? props : "");
+    x->bus = qpci_new_pc(x->qts, NULL);
+    x->dev = qpci_device_find(x->bus, QPCI_DEVFN(4, 0));
+    g_assert_nonnull(x->dev);
+    qpci_device_enable(x->dev);
+    x->bar = qpci_iomap(x->dev, 0, NULL);
+
+    caplen = rd32(x, 0) & 0xff;
+    nports = rd32(x, 4) >> 24;
+    x->op = caplen;
+    x->db = rd32(x, 0x14) & ~3u;
+    x->rt = rd32(x, 0x18) & ~0x1fu;
+
+    wr32(x, x->op + 0x00, 2);
+    for (i = 0; i < 100 && (rd32(x, x->op) & 2); i++) {
+        qtest_clock_step(x->qts, 1000 * 1000);
+    }
+    wr32(x, x->op + 0x38, 1);
+    for (i = 0; i < 0x3000; i += 4) {
+        qtest_writel(x->qts, DCBAA + i, 0);
+    }
+    wr64(x, x->op + 0x30, DCBAA);
+    wr64(x, x->op + 0x18, CMD_RING | 1);
+    qtest_writeq(x->qts, ERST, EVT_RING);
+    qtest_writel(x->qts, ERST + 8, EVT_TRBS);
+    qtest_writel(x->qts, ERST + 12, 0);
+    wr32(x, x->rt + 0x20 + 0x08, 1);
+    wr64(x, x->rt + 0x20 + 0x18, EVT_RING);
+    wr64(x, x->rt + 0x20 + 0x10, ERST);
+    x->evt_ccs = 1;
+    wr32(x, x->op + 0x00, 1);
+
+    for (i = 1; i <= nports; i++) {
+        portsc = rd32(x, x->op + 0x400 + 0x10 * (i - 1));
+        if (portsc & 1) {
+            port = i;
+            break;
+        }
+    }
+    g_assert_cmpuint(port, !=, 0);
+    wr32(x, x->op + 0x400 + 0x10 * (port - 1), (1 << 9) | (1 << 4));
+    for (i = 0; i < 100; i++) {
+        portsc = rd32(x, x->op + 0x400 + 0x10 * (port - 1));
+        if (portsc & 2) {
+            break;
+        }
+        qtest_clock_step(x->qts, 1000 * 1000);
+    }
+    g_assert_cmpuint(portsc & 2, ==, 2);
+    while (get_evt(x, &e)) {
+    }
+    x->portsc = portsc;
+    x->port = port;
+
+    e = cmd(x, 0, T_EN_SLOT << 10);
+    g_assert_cmpint(evt_cc(&e), ==, CC_SUCCESS);
+    x->slot = e.control >> 24;
+
+    ctx_clear(x, IN_CTX);
+    ctx_clear(x, OUT_CTX);
+    for (i = 0; i < 0x1000; i += 4) {
+        qtest_writel(x->qts, EP0_RING + i, 0);
+        qtest_writel(x->qts, OUT_RING + i, 0);
+        qtest_writel(x->qts, IN_RING + i, 0);
+    }
+    qtest_writel(x->qts, IN_CTX + 0x04, 3);
+    qtest_writel(x->qts, IN_CTX + 0x20, (1u << 27) |
+                 (((portsc >> 10) & 0xf) << 20));
+    qtest_writel(x->qts, IN_CTX + 0x24, port << 16);
+    qtest_writel(x->qts, IN_CTX + 0x44, (64 << 16) | (4 << 3) | (3 << 1));
+    qtest_writeq(x->qts, IN_CTX + 0x48, EP0_RING | 1);
+    qtest_writel(x->qts, IN_CTX + 0x50, 8);
+    qtest_writeq(x->qts, DCBAA + 8 * x->slot, OUT_CTX);
+    e = cmd(x, IN_CTX, (T_ADDR_DEV << 10) | (x->slot << 24));
+    g_assert_cmpint(evt_cc(&e), ==, CC_SUCCESS);
+}
+
+/* SET_CONFIGURATION(1) and Configure Endpoint for bulk OUT (+ IN). */
+static void prn_configure(PrnT *x, bool bidi)
+{
+    Evt e;
+    uint32_t add = 1 | (1 << OUT_DCI) | (bidi ? (1 << IN_DCI) : 0);
+    int last = bidi ? IN_DCI : OUT_DCI;
+
+    g_assert_cmpint(ctrl(x, 0x00, 9, 1, 0, 0, NULL, NULL), ==, CC_SUCCESS);
+    ctx_clear(x, IN_CTX);
+    qtest_writel(x->qts, IN_CTX + 0x04, add);
+    qtest_writel(x->qts, IN_CTX + 0x20, ((uint32_t)last << 27) |
+                 (((x->portsc >> 10) & 0xf) << 20));
+    qtest_writel(x->qts, IN_CTX + 0x24, x->port << 16);
+    qtest_writel(x->qts, IN_CTX + 0x20 + 0x20 * OUT_DCI + 4,
+                 (64 << 16) | (2 << 3) | (3 << 1));
+    qtest_writeq(x->qts, IN_CTX + 0x20 + 0x20 * OUT_DCI + 8, OUT_RING | 1);
+    qtest_writel(x->qts, IN_CTX + 0x20 + 0x20 * OUT_DCI + 16, 512);
+    if (bidi) {
+        qtest_writel(x->qts, IN_CTX + 0x20 + 0x20 * IN_DCI + 4,
+                     (64 << 16) | (6 << 3) | (3 << 1));
+        qtest_writeq(x->qts, IN_CTX + 0x20 + 0x20 * IN_DCI + 8,
+                     IN_RING | 1);
+        qtest_writel(x->qts, IN_CTX + 0x20 + 0x20 * IN_DCI + 16, 512);
+    }
+    e = cmd(x, IN_CTX, (T_CFG_EP << 10) | (x->slot << 24));
+    g_assert_cmpint(evt_cc(&e), ==, CC_SUCCESS);
+}
+
+static void prn_teardown(PrnT *x)
+{
+    g_free(x->dev);
+    qpci_free_pc(x->bus);
+    qtest_quit(x->qts);
+    unlink(x->file);
+    g_free(x->file);
+}
+
+static void qom_set_bool(PrnT *x, const char *prop, bool v)
+{
+    QDict *r = qtest_qmp(x->qts, "{'execute': 'qom-set', 'arguments': "
+                         "{'path': '/machine/peripheral/prn', "
+                         "'property': %s, 'value': %i}}", prop, v);
+    g_assert_true(qdict_haskey(r, "return"));
+    qobject_unref(r);
+}
+
+static void qom_set_str(PrnT *x, const char *prop, const char *v)
+{
+    QDict *r = qtest_qmp(x->qts, "{'execute': 'qom-set', 'arguments': "
+                         "{'path': '/machine/peripheral/prn', "
+                         "'property': %s, 'value': %s}}", prop, v);
+    g_assert_true(qdict_haskey(r, "return"));
+    qobject_unref(r);
+}
+
+/* Queue one bulk TD (OUT: data written first) and ring the doorbell. */
+static uint64_t bulk_put(PrnT *x, bool in, uint64_t buf, const void *data,
+                         uint32_t len)
+{
+    uint64_t ring = in ? IN_RING : OUT_RING;
+    uint32_t *idx = in ? &x->in_idx : &x->out_idx;
+    uint64_t at = ring + 16ULL * *idx;
+
+    g_assert_cmpuint(*idx + 1, <, RING_TRBS);
+    if (!in && len) {
+        qtest_memwrite(x->qts, buf, data, len);
+    }
+    put_trb(x, at, buf, len, (T_NORMAL << 10) | (1 << 5) | (1 << 2) | 1);
+    (*idx)++;
+    wr32(x, x->db + 4 * x->slot, in ? IN_DCI : OUT_DCI);
+    return at;
+}
+
+static void bulk_wait(PrnT *x, uint64_t at, int *residual)
+{
+    Evt e;
+
+    g_assert_true(wait_evt(x, &e));
+    g_assert_cmpint(evt_type(&e), ==, T_EV_XFER);
+    g_assert_cmphex(e.ptr, ==, at);
+    g_assert_true(evt_cc(&e) == CC_SUCCESS || evt_cc(&e) == CC_SHORT);
+    if (residual) {
+        *residual = e.status & 0xffffff;
+    }
+}
+
+static gchar *file_text(PrnT *x, gsize *len)
+{
+    gchar *t = NULL;
+
+    g_assert_true(g_file_get_contents(x->file, &t, len, NULL));
+    return t;
+}
+
+static void test_descriptors(void)
+{
+    PrnT x = {};
+    uint8_t d[64];
+    int n;
+
+    prn_bringup(&x, NULL);
+    g_assert_cmpint(ctrl(&x, 0x80, 6, 0x0200, 0, 64, d, &n), ==, CC_SUCCESS);
+    g_assert_cmpint(n, ==, 9 + 9 + 7 + 7);
+    /* interface 07/01/02, two endpoints: bulk OUT 0x01, bulk IN 0x82 */
+    g_assert_cmpint(d[9 + 4], ==, 2);
+    g_assert_cmpint(d[9 + 5], ==, 0x07);
+    g_assert_cmpint(d[9 + 6], ==, 0x01);
+    g_assert_cmpint(d[9 + 7], ==, 0x02);
+    g_assert_cmphex(d[18 + 2], ==, 0x01);
+    g_assert_cmpint(d[18 + 3], ==, 2);
+    g_assert_cmphex(d[25 + 2], ==, 0x82);
+    g_assert_cmpint(d[25 + 3], ==, 2);
+    prn_teardown(&x);
+
+    prn_bringup(&x, "protocol=1");
+    g_assert_cmpint(ctrl(&x, 0x80, 6, 0x0200, 0, 64, d, &n), ==, CC_SUCCESS);
+    g_assert_cmpint(n, ==, 9 + 9 + 7);
+    g_assert_cmpint(d[9 + 4], ==, 1);
+    g_assert_cmpint(d[9 + 7], ==, 0x01);
+    g_assert_cmphex(d[18 + 2], ==, 0x01);
+    prn_teardown(&x);
+}
+
+static void test_device_id(void)
+{
+    static const char id[] = "MFG:ACME;MDL:Model-9;CMD:PCL;CLS:PRINTER;";
+    PrnT x = {};
+    uint8_t d[1100];
+    int n;
+
+    prn_bringup(&x, "device-id=MFG:ACME;MDL:Model-9;CMD:PCL;CLS:PRINTER;");
+    prn_configure(&x, true);
+    g_assert_cmpint(ctrl(&x, 0xa1, 0, 0, 0, 1024, d, &n), ==, CC_SUCCESS);
+    g_assert_cmpint(n, ==, (int)strlen(id) + 2);
+    g_assert_cmpint((d[0] << 8) | d[1], ==, (int)strlen(id) + 2);
+    g_assert_cmpmem(d + 2, n - 2, id, strlen(id));
+    /* a short buffer gets the first bytes, length field intact */
+    g_assert_cmpint(ctrl(&x, 0xa1, 0, 0, 0, 4, d, &n), ==, CC_SUCCESS);
+    g_assert_cmpint(n, ==, 4);
+    g_assert_cmpint((d[0] << 8) | d[1], ==, (int)strlen(id) + 2);
+    g_assert_cmpmem(d + 2, 2, "MF", 2);
+    /* another interface: stall */
+    g_assert_cmpint(ctrl(&x, 0xa1, 0, 0, 0x0100, 1024, d, &n), ==, CC_STALL);
+    prn_teardown(&x);
+}
+
+static void test_port_status(void)
+{
+    PrnT x = {};
+    uint8_t d[4];
+    int n;
+
+    prn_bringup(&x, NULL);
+    g_assert_cmpint(ctrl(&x, 0xa1, 1, 0, 0, 1, d, &n), ==, CC_SUCCESS);
+    g_assert_cmpint(n, ==, 1);
+    g_assert_cmphex(d[0], ==, 0x18);            /* Select | Not Error */
+    qom_set_bool(&x, "paper-empty", true);
+    g_assert_cmpint(ctrl(&x, 0xa1, 1, 0, 0, 1, d, &n), ==, CC_SUCCESS);
+    g_assert_cmphex(d[0], ==, 0x38);
+    qom_set_bool(&x, "paper-empty", false);
+    qom_set_bool(&x, "error", true);
+    g_assert_cmpint(ctrl(&x, 0xa1, 1, 0, 0, 1, d, &n), ==, CC_SUCCESS);
+    g_assert_cmphex(d[0], ==, 0x10);
+    qom_set_bool(&x, "error", false);
+    qom_set_bool(&x, "offline", true);
+    g_assert_cmpint(ctrl(&x, 0xa1, 1, 0, 0, 1, d, &n), ==, CC_SUCCESS);
+    g_assert_cmphex(d[0], ==, 0x08);
+    prn_teardown(&x);
+}
+
+static void test_soft_reset(void)
+{
+    PrnT x = {};
+
+    prn_bringup(&x, NULL);
+    g_assert_cmpint(ctrl(&x, 0x21, 2, 0, 0, 0, NULL, NULL), ==, CC_SUCCESS);
+    g_assert_cmpint(ctrl(&x, 0x23, 2, 0, 0, 0, NULL, NULL), ==, CC_SUCCESS);
+    prn_teardown(&x);
+
+    /* a printer that wants the 1.0 code: 21h stalls, 23h works */
+    prn_bringup(&x, "reset-other-only=on");
+    g_assert_cmpint(ctrl(&x, 0x21, 2, 0, 0, 0, NULL, NULL), ==, CC_STALL);
+    prn_teardown(&x);
+    prn_bringup(&x, "reset-other-only=on");
+    g_assert_cmpint(ctrl(&x, 0x23, 2, 0, 0, 0, NULL, NULL), ==, CC_SUCCESS);
+    prn_teardown(&x);
+}
+
+static void test_bulk_out_file(void)
+{
+    static const char job[] = "\x1b%-12345X@PJL\r\n\x1b" "EHello\x0c\x1b" "E";
+    PrnT x = {};
+    gchar *t;
+    gsize len;
+    int res;
+
+    prn_bringup(&x, NULL);
+    prn_configure(&x, true);
+    bulk_wait(&x, bulk_put(&x, false, DATA_BUF, job, sizeof(job) - 1),
+              &res);
+    g_assert_cmpint(res, ==, 0);
+    t = file_text(&x, &len);
+    g_assert_cmpmem(t, len, job, sizeof(job) - 1);
+    g_free(t);
+    prn_teardown(&x);
+}
+
+static void test_out_held_on_fault(void)
+{
+    static const char a[] = "page one", b[] = "page two";
+    PrnT x = {};
+    uint64_t at;
+    gchar *t;
+    gsize len;
+    Evt e;
+
+    prn_bringup(&x, NULL);
+    prn_configure(&x, true);
+    bulk_wait(&x, bulk_put(&x, false, DATA_BUF, a, 8), NULL);
+    qom_set_bool(&x, "paper-empty", true);
+    at = bulk_put(&x, false, DATA_BUF + 0x100, b, 8);
+    qtest_clock_step(x.qts, 50 * 1000 * 1000);
+    g_assert_false(get_evt(&x, &e));            /* NAKed: no paper */
+    t = file_text(&x, &len);
+    g_assert_cmpmem(t, len, a, 8);
+    g_free(t);
+    qom_set_bool(&x, "paper-empty", false);     /* wakes the endpoint */
+    bulk_wait(&x, at, NULL);
+    t = file_text(&x, &len);
+    g_assert_cmpmem(t, len, "page onepage two", 16);
+    g_free(t);
+
+    /* busy holds data with the status benign */
+    qom_set_bool(&x, "busy", true);
+    at = bulk_put(&x, false, DATA_BUF + 0x200, a, 8);
+    qtest_clock_step(x.qts, 50 * 1000 * 1000);
+    g_assert_false(get_evt(&x, &e));
+    qom_set_bool(&x, "busy", false);
+    bulk_wait(&x, at, NULL);
+    prn_teardown(&x);
+}
+
+static void test_out_rate(void)
+{
+    static uint8_t blk[512];
+    PrnT x = {};
+    uint64_t at;
+    Evt e;
+
+    /* 512 bytes per second: the second TD waits about a second */
+    prn_bringup(&x, "out-rate=512");
+    prn_configure(&x, true);
+    bulk_wait(&x, bulk_put(&x, false, DATA_BUF, blk, sizeof(blk)), NULL);
+    at = bulk_put(&x, false, DATA_BUF + 0x400, blk, sizeof(blk));
+    qtest_clock_step(x.qts, 500 * 1000 * 1000);
+    g_assert_false(get_evt(&x, &e));
+    qtest_clock_step(x.qts, 600 * 1000 * 1000);
+    bulk_wait(&x, at, NULL);
+    prn_teardown(&x);
+}
+
+static void test_bulk_in(void)
+{
+    static const char q1[] = "\x1b%-12345X@PJL INFO ", q2[] = "STATUS\r\n";
+    static const char ready[] = "@PJL INFO STATUS\r\nCODE=10001\r\n";
+    PrnT x = {};
+    uint64_t at;
+    char r[256];
+    int res;
+    Evt e;
+
+    prn_bringup(&x, NULL);
+    prn_configure(&x, true);
+    /* nothing queued: IN NAKs */
+    at = bulk_put(&x, true, DATA_BUF + 0x800, NULL, 256);
+    qtest_clock_step(x.qts, 20 * 1000 * 1000);
+    g_assert_false(get_evt(&x, &e));
+    /* the query split over two TDs is still found; the reply is short */
+    bulk_wait(&x, bulk_put(&x, false, DATA_BUF, q1, sizeof(q1) - 1), NULL);
+    {
+        /* the reply wakes the pending IN: its event may come first */
+        uint64_t out_at = bulk_put(&x, false, DATA_BUF + 0x100, q2,
+                                   sizeof(q2) - 1);
+        bool got_in = false, got_out = false;
+        int i;
+
+        res = -1;
+        for (i = 0; i < 2; i++) {
+            g_assert_true(wait_evt(&x, &e));
+            g_assert_cmpint(evt_type(&e), ==, T_EV_XFER);
+            if (e.ptr == at) {
+                got_in = true;
+                res = e.status & 0xffffff;
+            } else {
+                g_assert_cmphex(e.ptr, ==, out_at);
+                got_out = true;
+            }
+        }
+        g_assert_true(got_in && got_out);
+    }
+    g_assert_cmpint(res, >, 0);
+    qtest_memread(x.qts, DATA_BUF + 0x800, r, 256 - res);
+    g_assert_cmpmem(r, strlen(ready), ready, strlen(ready));
+    g_assert_cmpint(r[256 - res - 1], ==, '\f');
+    prn_teardown(&x);
+
+    /* paper out, data not held: the reply says so */
+    prn_bringup(&x, "hold-on-fault=off");
+    prn_configure(&x, true);
+    qom_set_bool(&x, "paper-empty", true);
+    bulk_wait(&x, bulk_put(&x, false, DATA_BUF, "@PJL INFO STATUS", 16),
+              NULL);
+    bulk_wait(&x, bulk_put(&x, true, DATA_BUF + 0x800, NULL, 256), &res);
+    qtest_memread(x.qts, DATA_BUF + 0x800, r, 256 - res);
+    g_assert_nonnull(g_strstr_len(r, 256 - res, "CODE=41000"));
+    prn_teardown(&x);
+
+    /* in-inject queues raw bytes */
+    prn_bringup(&x, NULL);
+    prn_configure(&x, true);
+    qom_set_str(&x, "in-inject", "XYZ");
+    bulk_wait(&x, bulk_put(&x, true, DATA_BUF + 0x800, NULL, 64), &res);
+    g_assert_cmpint(64 - res, ==, 3);
+    qtest_memread(x.qts, DATA_BUF + 0x800, r, 3);
+    g_assert_cmpmem(r, 3, "XYZ", 3);
+
+    /* a reply that ends on a full packet is ended by a zero-length one
+     * (a host reading one packet per TD, as UHCI does, needs it) */
+    qom_set_str(&x, "in-inject",
+                "0123456789abcdef0123456789abcdef"
+                "0123456789abcdef0123456789abcdef");
+    bulk_wait(&x, bulk_put(&x, true, DATA_BUF + 0x800, NULL, 64), &res);
+    g_assert_cmpint(res, ==, 0);
+    bulk_wait(&x, bulk_put(&x, true, DATA_BUF + 0x800, NULL, 64), &res);
+    g_assert_cmpint(res, ==, 64);
+    /* and then nothing: the next IN NAKs */
+    bulk_put(&x, true, DATA_BUF + 0x800, NULL, 64);
+    qtest_clock_step(x.qts, 20 * 1000 * 1000);
+    g_assert_false(get_evt(&x, &e));
+    prn_teardown(&x);
+
+    /* the same reply through a larger TD ends short there: no zero-length
+     * packet follows, the next IN stays pending */
+    prn_bringup(&x, NULL);
+    prn_configure(&x, true);
+    qom_set_str(&x, "in-inject",
+                "0123456789abcdef0123456789abcdef"
+                "0123456789abcdef0123456789abcdef");
+    bulk_wait(&x, bulk_put(&x, true, DATA_BUF + 0x800, NULL, 256), &res);
+    g_assert_cmpint(res, ==, 256 - 64);
+    bulk_put(&x, true, DATA_BUF + 0x800, NULL, 256);
+    qtest_clock_step(x.qts, 20 * 1000 * 1000);
+    g_assert_false(get_evt(&x, &e));
+    prn_teardown(&x);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("/usb/printer/descriptors", test_descriptors);
+    qtest_add_func("/usb/printer/device-id", test_device_id);
+    qtest_add_func("/usb/printer/port-status", test_port_status);
+    qtest_add_func("/usb/printer/soft-reset", test_soft_reset);
+    qtest_add_func("/usb/printer/bulk-out-file", test_bulk_out_file);
+    qtest_add_func("/usb/printer/out-held-on-fault", test_out_held_on_fault);
+    qtest_add_func("/usb/printer/out-rate", test_out_rate);
+    qtest_add_func("/usb/printer/bulk-in", test_bulk_in);
+
+    return g_test_run();
+}
