+/* Original diagnostics: all recording is under BQL; nothing is written until
+ * normal process exit. Forced termination deliberately leaves no success dump.
+ * These timestamps observe host monotonic time without driving VM timers. */
+#define HOST_WAIT_CAPACITY 8192
+#define HOST_WAIT_SLOW_NS INT64_C(50000000)
+typedef struct HostWaitRecord {
+    const char *tag;
+    int64_t start, duration, requested;
+} HostWaitRecord;
+static HostWaitRecord host_wait_records[HOST_WAIT_CAPACITY];
+static unsigned host_wait_count;
+static uint64_t host_wait_overflow, host_wait_backsteps;
+static int host_wait_enabled = -1;
+static bool host_wait_frozen;
+
+static void host_wait_dump(void)
+{
+    unsigned i;
+    {
+        BQL_LOCK_GUARD();
+        host_wait_frozen = true;
+    }
+    /* Writers check frozen under BQL; release BQL before any exit-only I/O. */
+    fprintf(stderr, "HOST_WAIT_BEGIN count=%u overflow=%" PRIu64
+            " backsteps=%" PRIu64 "\n", host_wait_count,
+            host_wait_overflow, host_wait_backsteps);
+    for (i = 0; i < host_wait_count; i++) {
+        HostWaitRecord *r = &host_wait_records[i];
+        const char *unit = "none";
+        if (!strcmp(r->tag, "poll") || !strcmp(r->tag, "pre_wait") ||
+            !strcmp(r->tag, "fill_deadlines") ||
+            !strcmp(r->tag, "win_polling_entries")) {
+            unit = "ns";
+        } else if (!strcmp(r->tag, "usb_set_config")) {
+            unit = "configuration";
+        } else if (!strcmp(r->tag, "usb_set_interface")) {
+            unit = "interface_shift32_or_alt";
+        }
+        fprintf(stderr, "HOST_WAIT tag=%s start_ns=%" PRId64
+                " duration_ns=%" PRId64 " aux=%" PRId64 " aux_unit=%s\n",
+                r->tag, r->start, r->duration, r->requested, unit);
+    }
+    fprintf(stderr, "HOST_WAIT_END count=%u\n", host_wait_count);
+    fflush(stderr);
+}
+
+int64_t qemu_host_wait_now(void)
+{
+    if (host_wait_enabled < 0) {
+#ifdef CONFIG_WIN32
+        const char *value = getenv("QEMU_HOST_WAIT_DIAG");
+        host_wait_enabled = value && !strcmp(value, "1");
+#else
+        host_wait_enabled = 0;
+#endif
+        if (host_wait_enabled && atexit(host_wait_dump)) {
+            host_wait_enabled = 0;
+        }
+    }
+    return host_wait_enabled ? qemu_clock_get_ns(QEMU_CLOCK_REALTIME) : 0;
+}
+
+void qemu_host_wait_record(const char *tag, int64_t start,
+                           int64_t end, int64_t requested)
+{
+    HostWaitRecord *r;
+    if (host_wait_enabled != 1 || start == 0) {
+        return;
+    }
+    assert(bql_locked());
+    if (host_wait_frozen) {
+        return;
+    }
+    if (end < start) {
+        host_wait_backsteps++;
+        return;
+    }
+    if (end - start < HOST_WAIT_SLOW_NS) {
+        return;
+    }
+    if (host_wait_count == HOST_WAIT_CAPACITY) {
+        host_wait_overflow++;
+        return;
+    }
+    r = &host_wait_records[host_wait_count++];
+    r->tag = tag;
+    r->start = start;
+    r->duration = end - start;
+    r->requested = requested;
+}
 
