;
; AX179F98.INF - usb-wdm-free AX179F: ASIX AX88179 / AX88178A USB Gigabit
; Ethernet, Windows 98 SE and ME (ethernet.md sections 4.4, 7.1 and 7.4).
; NDIS.VXD loads the WDM miniport (DevLoader=*ndis, DeviceVxDs). A
; $Chicago$ INF is refused for Net on Windows 2000 (cdcnet's 2000 run),
; so AX179F.INF is the 2000 INF. Written from the Windows 2000 DDK network
; guide's INF pages and the Windows 98 DDK documentation; no DDK sample
; INF was read. The ids and the revision rule are AX179F.INF's.

[Version]
Signature="$Chicago$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=11/10/2026,0.1.4.0

[Manufacturer]
%Provider%=Models

[Models]
%Ax88179%=AX,USB\VID_0B95&PID_1790&REV_0100
%Ax88178a%=AX,USB\VID_0B95&PID_178A
%Gx3%=AX,USB\VID_04B4&PID_3610
%Dub1312%=AX,USB\VID_2001&PID_4A00
%Sitecom%=AX,USB\VID_0DF6&PID_0072
%Samsung%=AX,USB\VID_04E8&PID_A100
%Lenovo%=AX,USB\VID_17EF&PID_304B
%Belkin%=AX,USB\VID_050D&PID_0128
%Toshiba%=AX,USB\VID_0930&PID_0A13
%Mct%=AX,USB\VID_0711&PID_0179
%Umc2000%=AX_AT1G,USB\VID_07C9&PID_000E
%Umc200%=AX_AT100,USB\VID_07C9&PID_000F
%Umc2000sp%=AX_ATSP,USB\VID_07C9&PID_0010

[ControlFlags]
ExcludeFromSelect=*

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
ax179f.sys=1

[DestinationDirs]
Copy9x=11

[AX]
CopyFiles=Copy9x
AddReg=Reg9x,Params,Speed,Flow,Eee

[AX_AT1G]
CopyFiles=Copy9x
AddReg=Reg9x,Params,SpeedAt1G,FlowAt,EeeAt

[AX_AT100]
CopyFiles=Copy9x
AddReg=Reg9x,Params,SpeedAt100,FlowAt,EeeAt

[AX_ATSP]
CopyFiles=Copy9x
AddReg=Reg9x,Params,SpeedAtSp,FlowAt,EeeAt

[Copy9x]
ax179f.sys

[Reg9x]
HKR,,DevLoader,,*ndis
HKR,,DeviceVxDs,,ax179f.sys
HKR,,EnumPropPages,,"netdi.dll,EnumPropPages"
HKR,NDIS,LogDriverName,,AX179F
HKR,NDIS,MajorNdisVersion,1,05
HKR,NDIS,MinorNdisVersion,1,00
HKR,Ndi,DeviceID,,"USB\AX179F"
HKR,Ndi\Interfaces,DefUpper,,ndis3
HKR,Ndi\Interfaces,UpperRange,,"ndis3,ndis4,ndis5"
HKR,Ndi\Interfaces,DefLower,,ethernet
HKR,Ndi\Interfaces,LowerRange,,ethernet
HKR,Ndi\Install,ndis3,,AX.ndis
HKR,Ndi\Install,ndis4,,AX.ndis
HKR,Ndi\Install,ndis5,,AX.ndis

[AX.ndis]
CopyFiles=Copy9x

; The Advanced tab (ethernet.md section 4.10): ASIX's AX88179 7 INF's
; keywords, values and defaults, each written to the driver key at its
; default (no-clobber, so a reinstall keeps a changed value); the Allied
; Telesis media converters with the fixed speed, flow control off and no
; EEE of their own sections there.
; The locally administered address (ethernet.md 4.8).
[Params]
HKR,Ndi\params\NetworkAddress,ParamDesc,,%AddressDesc%
HKR,Ndi\params\NetworkAddress,type,,edit
HKR,Ndi\params\NetworkAddress,LimitText,,12
HKR,Ndi\params\NetworkAddress,UpperCase,,1
HKR,Ndi\params\NetworkAddress,optional,,1
HKR,Ndi\params\NetworkAddress,default,,""

[Speed]
HKR,Ndi\params\*SpeedDuplex,ParamDesc,,%SpeedDesc%
HKR,Ndi\params\*SpeedDuplex,type,,enum
HKR,Ndi\params\*SpeedDuplex,default,,0
HKR,Ndi\params\*SpeedDuplex\enum,0,,%Auto%
HKR,Ndi\params\*SpeedDuplex\enum,1,,%S10H%
HKR,Ndi\params\*SpeedDuplex\enum,2,,%S10F%
HKR,Ndi\params\*SpeedDuplex\enum,3,,%S100H%
HKR,Ndi\params\*SpeedDuplex\enum,4,,%S100F%
HKR,Ndi\params\*SpeedDuplex\enum,6,,%S1000F%
HKR,,*SpeedDuplex,2,"0"

[Flow]
HKR,Ndi\params\*FlowControl,ParamDesc,,%FlowDesc%
HKR,Ndi\params\*FlowControl,type,,enum
HKR,Ndi\params\*FlowControl,default,,3
HKR,Ndi\params\*FlowControl\enum,0,,%Off%
HKR,Ndi\params\*FlowControl\enum,1,,%TxOnly%
HKR,Ndi\params\*FlowControl\enum,2,,%RxOnly%
HKR,Ndi\params\*FlowControl\enum,3,,%RxTx%
HKR,,*FlowControl,2,"3"

[Eee]
HKR,Ndi\params\*EEE,ParamDesc,,%EeeDesc%
HKR,Ndi\params\*EEE,type,,enum
HKR,Ndi\params\*EEE,default,,1
HKR,Ndi\params\*EEE\enum,0,,%Off%
HKR,Ndi\params\*EEE\enum,1,,%On%
HKR,,*EEE,2,"1"

[SpeedAt1G]
HKR,Ndi\params\*SpeedDuplex,ParamDesc,,%SpeedDesc%
HKR,Ndi\params\*SpeedDuplex,type,,enum
HKR,Ndi\params\*SpeedDuplex,default,,6
HKR,Ndi\params\*SpeedDuplex\enum,6,,%S1000F%
HKR,,*SpeedDuplex,2,"6"

[FlowAt]
HKR,Ndi\params\*FlowControl,ParamDesc,,%FlowDesc%
HKR,Ndi\params\*FlowControl,type,,enum
HKR,Ndi\params\*FlowControl,default,,0
HKR,Ndi\params\*FlowControl\enum,0,,%Off%
HKR,Ndi\params\*FlowControl\enum,1,,%TxOnly%
HKR,Ndi\params\*FlowControl\enum,2,,%RxOnly%
HKR,Ndi\params\*FlowControl\enum,3,,%RxTx%
HKR,,*FlowControl,2,"0"

[EeeAt]
HKR,Ndi\params\*EEE,ParamDesc,,%EeeDesc%
HKR,Ndi\params\*EEE,type,,enum
HKR,Ndi\params\*EEE,default,,0
HKR,Ndi\params\*EEE\enum,0,,%Off%
HKR,,*EEE,2,"0"

[SpeedAt100]
HKR,Ndi\params\*SpeedDuplex,ParamDesc,,%SpeedDesc%
HKR,Ndi\params\*SpeedDuplex,type,,enum
HKR,Ndi\params\*SpeedDuplex,default,,4
HKR,Ndi\params\*SpeedDuplex\enum,4,,%S100F%
HKR,,*SpeedDuplex,2,"4"

[SpeedAtSp]
HKR,Ndi\params\*SpeedDuplex,ParamDesc,,%SpeedDesc%
HKR,Ndi\params\*SpeedDuplex,type,,enum
HKR,Ndi\params\*SpeedDuplex,default,,0
HKR,Ndi\params\*SpeedDuplex\enum,0,,%Auto%
HKR,,*SpeedDuplex,2,"0"

