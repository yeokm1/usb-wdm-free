;
; SR970098.INF - usb-wdm-free SR9700F: CoreChips SR9700 USB Ethernet,
; Windows 98 SE and ME (ethernet.md sections 4.4, 6.9.2, 7.1 and 7.4).
; NDIS.VXD loads the WDM miniport (DevLoader=*ndis, DeviceVxDs).
; SR9700F.INF is the 2000 to 7 INF. The id is Linux sr9700.c's; its
; 0FE6:9702 (the chip with a CD-ROM on interface 0) is listed only in
; SR9700F.INF: whether 98 SE and ME split that composite device is not
; shown. No maker's driver serves the SR9700 on any Windows. Written as
; AX179F98.INF is (the Windows 2000 DDK network guide's INF pages and the
; Windows 98 DDK documentation; no DDK sample INF was read).

[Version]
Signature="$Chicago$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=11/10/2026,0.1.1.0

[Manufacturer]
%Provider%=Models

[Models]
%Sr9700%=SR,USB\VID_0FE6&PID_9700

[ControlFlags]
ExcludeFromSelect=*

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
sr9700f.sys=1

[DestinationDirs]
Copy9x=11

[SR]
CopyFiles=Copy9x
AddReg=Reg9x,Params

[Copy9x]
sr9700f.sys

[Reg9x]
HKR,,DevLoader,,*ndis
HKR,,DeviceVxDs,,sr9700f.sys
HKR,,EnumPropPages,,"netdi.dll,EnumPropPages"
HKR,NDIS,LogDriverName,,SR9700F
HKR,NDIS,MajorNdisVersion,1,05
HKR,NDIS,MinorNdisVersion,1,00
HKR,Ndi,DeviceID,,"USB\SR9700F"
HKR,Ndi\Interfaces,DefUpper,,ndis3
HKR,Ndi\Interfaces,UpperRange,,"ndis3,ndis4,ndis5"
HKR,Ndi\Interfaces,DefLower,,ethernet
HKR,Ndi\Interfaces,LowerRange,,ethernet
HKR,Ndi\Install,ndis3,,SR.ndis
HKR,Ndi\Install,ndis4,,SR.ndis
HKR,Ndi\Install,ndis5,,SR.ndis

[SR.ndis]
CopyFiles=Copy9x

; The Advanced tab: a locally administered address (ethernet.md 4.8).
[Params]
HKR,Ndi\params\NetworkAddress,ParamDesc,,%AddressDesc%
HKR,Ndi\params\NetworkAddress,type,,edit
HKR,Ndi\params\NetworkAddress,LimitText,,12
HKR,Ndi\params\NetworkAddress,UpperCase,,1
HKR,Ndi\params\NetworkAddress,optional,,1
HKR,Ndi\params\NetworkAddress,default,,""

[Strings]
Provider="usb-wdm-free"
Disk="SR9700F installation disk"
AddressDesc="Network Address"
Sr9700="CoreChips SR9700 USB Ethernet (SR9700F)"
