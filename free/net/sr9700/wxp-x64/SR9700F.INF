;
; SR9700F.INF - usb-wdm-free SR9700F: CoreChips SR9700 USB Ethernet,
; Windows 2000, XP, XP x64, Vista and 7, x86 and x64 (ethernet.md sections
; 6.9.2 and 7.6). No maker's driver serves the SR9700 on any Windows.
; SR970098.INF is the Windows 98 SE and ME INF. Written as RTLXP7.INF is
; (the Windows 2000 DDK network guide's INF pages; no DDK sample INF was
; read).
;
; Models: [Models] for 2000 (which ignores decorations), NTx86.5.1 and
; NTamd64.5.2 (XP, XP x64), NTx86.6.0 / NTamd64.6.0 (Vista), NTx86.6.1 /
; NTamd64.6.1 (7): 0FE6:9700, and interface 1 of 0FE6:9702 (Linux
; sr9700.c). NTx86.6.2 / NTamd64.6.2: none, Windows 8 and later have no
; NDIS 5 (ethernet.md section 4.1).

[Version]
Signature="$Windows NT$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=11/10/2026,0.1.1.0

[Manufacturer]
%Provider%=Models,NTx86.5.1,NTamd64.5.2,NTx86.6.0,NTamd64.6.0,NTx86.6.1,NTamd64.6.1,NTx86.6.2,NTamd64.6.2

[Models]
%Sr9700%=SR,USB\VID_0FE6&PID_9700
%Sr9702%=SR,USB\VID_0FE6&PID_9702&MI_01

[Models.NTx86.5.1]
%Sr9700%=SR,USB\VID_0FE6&PID_9700
%Sr9702%=SR,USB\VID_0FE6&PID_9702&MI_01

[Models.NTamd64.5.2]
%Sr9700%=SR,USB\VID_0FE6&PID_9700
%Sr9702%=SR,USB\VID_0FE6&PID_9702&MI_01

[Models.NTx86.6.0]
%Sr9700%=SR,USB\VID_0FE6&PID_9700
%Sr9702%=SR,USB\VID_0FE6&PID_9702&MI_01

[Models.NTamd64.6.0]
%Sr9700%=SR,USB\VID_0FE6&PID_9700
%Sr9702%=SR,USB\VID_0FE6&PID_9702&MI_01

[Models.NTx86.6.1]
%Sr9700%=SR,USB\VID_0FE6&PID_9700
%Sr9702%=SR,USB\VID_0FE6&PID_9702&MI_01

[Models.NTamd64.6.1]
%Sr9700%=SR,USB\VID_0FE6&PID_9700
%Sr9702%=SR,USB\VID_0FE6&PID_9702&MI_01

[Models.NTx86.6.2]

[Models.NTamd64.6.2]

[ControlFlags]
ExcludeFromSelect=*

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
sr9700f.sys=1

[DestinationDirs]
CopyNT=12

[SR.NT]
Characteristics=0x84
BusType=15
CopyFiles=CopyNT
AddReg=RegNT,Params
*IfType=6
*MediaType=0
*PhysicalMediaType=14

[SR.NTamd64]
Characteristics=0x84
BusType=15
CopyFiles=CopyNT
AddReg=RegNT,Params
*IfType=6
*MediaType=0
*PhysicalMediaType=14

[CopyNT]
sr9700f.sys

[RegNT]
HKR,Ndi,Service,,sr9700f
HKR,Ndi\Interfaces,UpperRange,,ndis5
HKR,Ndi\Interfaces,LowerRange,,ethernet

[SR.NT.Services]
AddService=sr9700f,2,Service,EventLog

[SR.NTamd64.Services]
AddService=sr9700f,2,Service,EventLog

[Service]
DisplayName=%Service%
ServiceType=1
StartType=3
ErrorControl=1
LoadOrderGroup=NDIS
ServiceBinary=%12%\sr9700f.sys

[EventLog]
AddReg=EventLogReg

[EventLogReg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\netevent.dll"
HKR,,TypesSupported,0x00010001,7

; The Advanced tab: a locally administered address (ethernet.md 4.8).
[Params]
HKR,Ndi\params\NetworkAddress,ParamDesc,,%AddressDesc%
HKR,Ndi\params\NetworkAddress,type,,edit
HKR,Ndi\params\NetworkAddress,LimitText,,12
HKR,Ndi\params\NetworkAddress,UpperCase,,1
HKR,Ndi\params\NetworkAddress,optional,,1
HKR,Ndi\params\NetworkAddress,default,,""

[Strings]
Provider="usb-wdm-free"
Disk="SR9700F installation disk"
Service="usb-wdm-free SR9700F USB Ethernet"
AddressDesc="Network Address"
Sr9700="CoreChips SR9700 USB Ethernet (SR9700F)"
Sr9702="CoreChips SR9700 USB Ethernet with a driver disc (SR9700F)"
