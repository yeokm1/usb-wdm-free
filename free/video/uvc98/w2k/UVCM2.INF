; SPDX-License-Identifier: GPL-2.0-or-later
; Copyright (C) 2026 Yeo Kheng Meng
; Original Windows 2000 form of uvc98 (UVCM298.INF is the 98 SE / ME form):
; USB Video Class 1.0 to 1.5 cameras, matched by their video function's
; class ids (owner, 2026-10-24).
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/26/2026,0.1.2.0
[Manufacturer]
%Provider%=Models
[Models]
; Interface-level (function) ids only (design 4; owner, 2026-10-20, and
; 2026-10-24 for the class match): the IAD video function that xHCI98
; splits off (SubClass_03), and the VideoControl interface of a camera a
; stack splits per interface (SubClass_01; protocol 01 is UVC 1.5's).
; No DevClass match. Where a hub does not split the camera (2000, NUSB) the
; whole device carries its first interface's ids, so SubClass_01 binds it
; as a whole device; the driver serves its video function (uvc.md 4).
%Uvc%=Capture,USB\Class_0E&SubClass_03&Prot_00
%Uvc%=Capture,USB\Class_0E&SubClass_01&Prot_00
%Uvc%=Capture,USB\Class_0E&SubClass_01&Prot_01
; Per-camera whole-device line (design 4: an unsplit camera, by request):
; the camera of the NUSB legs, which NUSB's hub does not split.
%UvcWhole%=Capture,USB\VID_046D&PID_094C
[DestinationDirs]
MiniFiles=12
[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
uvcm2.sys=1
[MiniFiles]
uvcm2.sys
[Capture.NT]
Include=ks.inf,kscaptur.inf
Needs=KS.Registration,KSCAPTUR.Registration.NT
CopyFiles=MiniFiles
[Capture.NT.Services]
AddService=uvcm2,0x00000002,MiniService
[MiniService]
DisplayName=%Uvc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\uvcm2.sys
[Capture.NT.Interfaces]
AddInterface=%Video%,GLOBAL,Interface
AddInterface=%Capture%,GLOBAL,Interface
[Interface]
AddReg=InterfaceReg
[InterfaceReg]
HKR,,CLSID,,%KSProxy%
HKR,,FriendlyName,,%Uvc%
[Strings]
Provider="usb-wdm-free"
Uvc="USB Video Class camera (uvc98)"
UvcWhole="USB Video Class camera, whole device (uvc98)"
Disk="usb-wdm-free uvc98"
Video="{6994AD05-93EF-11D0-A3CC-00A0C9223196}"
Capture="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSProxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
