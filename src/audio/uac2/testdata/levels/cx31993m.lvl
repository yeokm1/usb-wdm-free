# cx31993m: uacemu --profile cx31993m --vol-range -32512:3072:256 --vol-cur 3072 (Feature Unit 0x10,
# volume per channel, no mute; a CUR of +12 dB at power-up), XP SP3 on EHCI, uac2 0.1.12.0 (release 0.1.11).
# First arrival (no Uac2Level), the mixer steps of UACWAV, a play, then a replug and one more step.
# WDMAud sets a stereo volume as a SET of channel 0 then channel 1 and a mute as one SET; at the
# replug it sets its saved mixer state again (4 SETs, no change of value).
!profile ..\cx31993m\config0.bin 0 0 2
!nosaved
!start 1 2 14
# SET_INTERFACE 1 alt 0
!stop
A1 02 0201 1000 50 0 8 01000081000c0001
A1 02 0202 1000 50 0 8 01000081000c0001
A1 01 0201 1000 2 0 2 000c
A1 01 0202 1000 2 0 2 000c
21 01 0201 1000 2 0 2 0000
21 01 0202 1000 2 0 2 0000
!run
# SET_INTERFACE 1 alt 1
# SET_INTERFACE 1 alt 0
!stop
# MARK c9 vol 65535
# MARK c9 vol 32768
!vol 0 -524288
!vol 1 -524288
21 01 0201 1000 2 0 2 00f8
21 01 0202 1000 2 0 2 00f8
# MARK c9 vol 6554
!vol 0 -1703936
!vol 1 -1703936
21 01 0201 1000 2 0 2 00e6
21 01 0202 1000 2 0 2 00e6
# MARK c9 vol 32768 16384
!vol 0 -524288
!vol 1 -1048576
21 01 0201 1000 2 0 2 00f8
21 01 0202 1000 2 0 2 00f0
!change 6
!diag 
!savedis 020000000200000001000000000000000000F8FF0000F0FF000000000000000000000000000000000000000000000000
# MARK c9 mute 1
!mute -1 1
# MARK c9 mute 0
!mute -1 0
!change 8
!diag 
!savedis 020000000200000003000000000000000000F8FF0000F0FF000000000000000000000000000000000000000000000000
# MARK c9 play
!run
# SET_INTERFACE 1 alt 1
# SET_INTERFACE 1 alt 0
!stop
!change 8
!diag 
!savedis 020000000200000003000000000000000000F8FF0000F0FF000000000000000000000000000000000000000000000000
# MARK c9 unplug
!saved 020000000200000003000000000000000000F8FF0000F0FF000000000000000000000000000000000000000000000000
!start 1 2 14
# SET_INTERFACE 1 alt 0
!stop
A1 02 0201 1000 50 0 8 01000081000c0001
A1 02 0202 1000 50 0 8 01000081000c0001
A1 01 0201 1000 2 0 2 000c
A1 01 0202 1000 2 0 2 000c
21 01 0201 1000 2 0 2 0000
21 01 0202 1000 2 0 2 0000
21 01 0201 1000 2 0 2 00f8
21 01 0202 1000 2 0 2 00f0
!run
# SET_INTERFACE 1 alt 1
# SET_INTERFACE 1 alt 0
!stop
!vol 0 -524288
!vol 1 -1048576
!mute -1 0
!mute -1 0
!change 4
!diag 
!savedis 020000000200000003000000000000000000F8FF0000F0FF000000000000000000000000000000000000000000000000
# MARK c10 vol 49152
!vol 0 -196608
!vol 1 -196608
21 01 0201 1000 2 0 2 00fd
21 01 0202 1000 2 0 2 00fd
!change 6
!diag 
!savedis 020000000200000003000000000000000000FDFF0000FDFF000000000000000000000000000000000000000000000000
# MARK c10 play
!run
# SET_INTERFACE 1 alt 1
# SET_INTERFACE 1 alt 0
!stop
!change 6
!diag 
!savedis 020000000200000003000000000000000000FDFF0000FDFF000000000000000000000000000000000000000000000000
# MARK c10 unplug
!end
