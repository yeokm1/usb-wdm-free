# hs24 --fu full: uacemu --profile hs24 --fu full --vol-range -15360:3072:128 --vol-cur-at 0=1536 --vol-cur-at 1=-10240 --vol-cur-at 2=-10240
# (Feature Unit 2: master and channel mute and volume; master +6 dB, channels -40 dB at power-up), XP SP3 on EHCI,
# uac2 0.1.12.0 (release 0.1.11): first arrival, the mixer steps of UACWAV, a play, a replug, one more step, a play.
!profile hs24-full.bin 0 0 3
# MARK hf1 plug
!nosaved
!start 1 2 1
# SET_INTERFACE 1 alt 0
!stop
# SET_INTERFACE 2 alt 0
!stop
A1 02 0200 0200 50 0 8 010000c4000c8000
A1 02 0201 0200 50 0 8 010000c4000c8000
A1 02 0202 0200 50 0 8 010000c4000c8000
A1 01 0200 0200 2 0 2 0006
A1 01 0100 0200 1 0 1 00
A1 01 0201 0200 2 0 2 00d8
A1 01 0101 0200 1 0 1 00
A1 01 0202 0200 2 0 2 00d8
A1 01 0102 0200 1 0 1 00
21 01 0200 0200 2 0 2 0000
!run
# (stream start, uacusb ReadFeature) A1 01 0100 0200 1 0 1 00
# (stream start, uacusb ReadFeature) A1 01 0200 0200 2 0 2 0000
# SET_INTERFACE 1 alt 1
# SET_INTERFACE 1 alt 0
!stop
!change 0
!diag 
# MARK hf1 vol 65535
!change 0
!diag 
# MARK hf1 vol 32768
!vol 0 -393216
!vol 1 -393216
21 01 0201 0200 2 0 2 0000
21 01 0202 0200 2 0 2 0000
21 01 0200 0200 2 0 2 00fa
!change 2
!diag 
!savedis 020000000200000001000000000000000000FAFF0000FAFF000000000000000000000000000000000000000000000000
# MARK hf1 vol 6554
!vol 0 -1310720
!vol 1 -1310720
21 01 0200 0200 2 0 2 00ec
!change 4
!diag 
!savedis 020000000200000001000000000000000000ECFF0000ECFF000000000000000000000000000000000000000000000000
# MARK hf1 vol 32768 16384
!vol 0 -393216
!vol 1 -786432
21 01 0200 0200 2 0 2 00fa
!change 6
!diag 
!savedis 020000000200000001000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK hf1 mute 1
!mute -1 1
21 01 0100 0200 1 0 1 01
!change 7
!diag 
!savedis 020000000200000003000000010000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK hf1 mute 0
!mute -1 0
21 01 0100 0200 1 0 1 00
!change 8
!diag 
!savedis 020000000200000003000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK hf1 play
!run
# (stream start, uacusb ReadFeature) A1 01 0100 0200 1 0 1 00
# (stream start, uacusb ReadFeature) A1 01 0200 0200 2 0 2 00fa
# SET_INTERFACE 1 alt 1
# SET_INTERFACE 1 alt 0
!stop
!change 8
!diag 
!savedis 020000000200000003000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK hf1 unplug
# MARK hf2 plug
!saved 020000000200000003000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
!start 1 2 1
# SET_INTERFACE 1 alt 0
!stop
# SET_INTERFACE 2 alt 0
!stop
A1 02 0200 0200 50 0 8 010000c4000c8000
A1 02 0201 0200 50 0 8 010000c4000c8000
A1 02 0202 0200 50 0 8 010000c4000c8000
A1 01 0200 0200 2 0 2 0006
A1 01 0100 0200 1 0 1 00
A1 01 0201 0200 2 0 2 00d8
A1 01 0101 0200 1 0 1 00
A1 01 0202 0200 2 0 2 00d8
A1 01 0102 0200 1 0 1 00
21 01 0200 0200 2 0 2 0000
21 01 0200 0200 2 0 2 00fa
21 01 0201 0200 2 0 2 0000
21 01 0202 0200 2 0 2 0000
!run
# (stream start, uacusb ReadFeature) A1 01 0100 0200 1 0 1 00
# (stream start, uacusb ReadFeature) A1 01 0200 0200 2 0 2 00fa
# SET_INTERFACE 1 alt 1
# SET_INTERFACE 1 alt 0
!stop
!vol 0 -393216
!vol 1 -786432
!change 2
!diag 
!savedis 020000000200000003000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK hf2 vol 49152
!vol 0 -163840
!vol 1 -163840
21 01 0200 0200 2 0 2 80fd
!change 4
!diag 
!savedis 020000000200000003000000000000000080FDFF0080FDFF000000000000000000000000000000000000000000000000
# MARK hf2 play
!run
# (stream start, uacusb ReadFeature) A1 01 0100 0200 1 0 1 00
# (stream start, uacusb ReadFeature) A1 01 0200 0200 2 0 2 80fd
# SET_INTERFACE 1 alt 1
# SET_INTERFACE 1 alt 0
!stop
!change 4
!diag 
