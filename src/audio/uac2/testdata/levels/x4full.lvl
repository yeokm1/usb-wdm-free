# x4full: uacemu --profile x4full (the captured X4 layout; Feature Unit 1: master mute and volume and eight
# channel volumes after Mixer Unit 7), XP SP3 on EHCI, uac2 0.1.12.0 (release 0.1.11): first arrival, the mixer
# steps of UACWAV, a play, a replug, one more step, a play.
# The X4 makes two pairs (section 15.3): pair 1 drives Feature Unit 14 on the second playback terminal.
# Its requests (14) and the Uac2VolMap readings it wrote last (2) are left out: this file is pair 0's.
!profile ..\sbx4\config0.bin 3 3 4
# MARK x3 plug
!nosaved
!start 1 2 3
# SET_INTERFACE 4 alt 0
!stop
# SET_INTERFACE 5 alt 0
!stop
# SET_INTERFACE 6 alt 0
!stop
A1 02 0200 0103 50 0 8 010000a000000001
A1 02 0201 0103 50 0 8 010000a000000001
A1 02 0202 0103 50 0 8 010000a000000001
A1 02 0203 0103 50 0 8 010000a000000001
A1 02 0204 0103 50 0 8 010000a000000001
A1 02 0205 0103 50 0 8 010000a000000001
A1 02 0206 0103 50 0 8 010000a000000001
A1 02 0207 0103 50 0 8 010000a000000001
A1 02 0208 0103 50 0 8 010000a000000001
A1 01 0200 0103 2 0 2 0000
A1 01 0100 0103 1 0 1 00
A1 01 0201 0103 2 0 2 0000
A1 01 0202 0103 2 0 2 0000
A1 01 0203 0103 2 0 2 0000
A1 01 0204 0103 2 0 2 0000
A1 01 0205 0103 2 0 2 0000
A1 01 0206 0103 2 0 2 0000
A1 01 0207 0103 2 0 2 0000
A1 01 0208 0103 2 0 2 0000
!run
# (stream start, uacusb ReadFeature) A1 01 0100 0103 1 0 1 00
# (stream start, uacusb ReadFeature) A1 01 0200 0103 2 0 2 0000
# SET_INTERFACE 4 alt 1
# SET_INTERFACE 4 alt 0
!stop
# MARK x3 vol 65535
# MARK x3 vol 32768
!vol 0 -393216
!vol 1 -393216
21 01 0200 0103 2 0 2 00fa
!change 2
!diag 
!savedis 020000000200000001000000000000000000FAFF0000FAFF000000000000000000000000000000000000000000000000
# MARK x3 vol 6554
!vol 0 -1310720
!vol 1 -1310720
21 01 0200 0103 2 0 2 00ec
!change 4
!diag 
!savedis 020000000200000001000000000000000000ECFF0000ECFF000000000000000000000000000000000000000000000000
# MARK x3 vol 32768 16384
!vol 0 -393216
!vol 1 -786432
21 01 0200 0103 2 0 2 00fa
!change 6
!diag 
!savedis 020000000200000001000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK x3 mute 1
!mute -1 1
21 01 0100 0103 1 0 1 01
!change 7
!diag 
!savedis 020000000200000003000000010000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK x3 mute 0
!mute -1 0
21 01 0100 0103 1 0 1 00
!change 8
!diag 
!savedis 020000000200000003000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK x3 play
!run
# (stream start, uacusb ReadFeature) A1 01 0100 0103 1 0 1 00
# (stream start, uacusb ReadFeature) A1 01 0200 0103 2 0 2 00fa
# SET_INTERFACE 4 alt 1
# SET_INTERFACE 4 alt 0
!stop
!change 8
!diag 
!savedis 020000000200000003000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK x3 unplug
# MARK x4 plug
!saved 020000000200000003000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
!start 1 2 3
# SET_INTERFACE 4 alt 0
!stop
# SET_INTERFACE 5 alt 0
!stop
# SET_INTERFACE 6 alt 0
!stop
A1 02 0200 0103 50 0 8 010000a000000001
A1 02 0201 0103 50 0 8 010000a000000001
A1 02 0202 0103 50 0 8 010000a000000001
A1 02 0203 0103 50 0 8 010000a000000001
A1 02 0204 0103 50 0 8 010000a000000001
A1 02 0205 0103 50 0 8 010000a000000001
A1 02 0206 0103 50 0 8 010000a000000001
A1 02 0207 0103 50 0 8 010000a000000001
A1 02 0208 0103 50 0 8 010000a000000001
A1 01 0200 0103 2 0 2 0000
A1 01 0100 0103 1 0 1 00
A1 01 0201 0103 2 0 2 0000
A1 01 0202 0103 2 0 2 0000
A1 01 0203 0103 2 0 2 0000
A1 01 0204 0103 2 0 2 0000
A1 01 0205 0103 2 0 2 0000
A1 01 0206 0103 2 0 2 0000
A1 01 0207 0103 2 0 2 0000
A1 01 0208 0103 2 0 2 0000
21 01 0200 0103 2 0 2 00fa
!run
# (stream start, uacusb ReadFeature) A1 01 0100 0103 1 0 1 00
# (stream start, uacusb ReadFeature) A1 01 0200 0103 2 0 2 00fa
# SET_INTERFACE 4 alt 1
# SET_INTERFACE 4 alt 0
!stop
!vol 0 -393216
!vol 1 -786432
!mute -1 0
!mute -1 0
!change 4
!diag 
!savedis 020000000200000003000000000000000000FAFF0000F4FF000000000000000000000000000000000000000000000000
# MARK x4 vol 49152
!vol 0 -131072
!vol 1 -131072
21 01 0200 0103 2 0 2 00fe
!change 6
!diag 
!savedis 020000000200000003000000000000000000FEFF0000FEFF000000000000000000000000000000000000000000000000
# MARK x4 play
!run
# (stream start, uacusb ReadFeature) A1 01 0100 0103 1 0 1 00
# (stream start, uacusb ReadFeature) A1 01 0200 0103 2 0 2 00fe
# SET_INTERFACE 4 alt 1
# SET_INTERFACE 4 alt 0
!stop
!change 6
!diag 
!savedis 020000000200000003000000000000000000FEFF0000FEFF000000000000000000000000000000000000000000000000
# MARK x4 unplug
!end
