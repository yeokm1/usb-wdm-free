/* SPDX-License-Identifier: LGPL-2.1-or-later
 * Copyright (C) 2026 Yeo Kheng Meng
 *
 * Version resource of LIBUSB0.DLL. Upstream's src/resource.rc includes
 * src/common.rc, which carries a GPL header; the DLL stays
 * LGPL-2.1-or-later (docs/design/libusb.md 2.4), so it gets this script
 * instead, with the same values. RC_VERSION and RC_VERSION_STR come from
 * the build (build.ps1).
 */

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION    RC_VERSION
PRODUCTVERSION RC_VERSION
FILEFLAGSMASK  0x3FL
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "libusb-win32, rebuilt by usb-wdm-free"
            VALUE "FileDescription",  "LibUSB-Win32 - DLL"
            VALUE "FileVersion",      RC_VERSION_STR
            VALUE "InternalName",     "libusb0.dll"
            VALUE "LegalCopyright",   "2002-2005 S. Meyer; 2000-2003 J. Erdfelt; LGPL"
            VALUE "OriginalFilename", "libusb0.dll"
            VALUE "ProductName",      "LibUSB-Win32 - DLL"
            VALUE "ProductVersion",   RC_VERSION_STR
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
