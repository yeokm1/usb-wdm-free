; SPDX-License-Identifier: GPL-2.0-or-later
; absptr - Windows 98 SE and ME: absolute pointing devices Windows' own HID
; support does not map to the pointer (docs/design/absptr.md sections 1, 8).
; Copyright (C) 2026 Yeo Kheng Meng
; Experimental build; not released.
;
; Listed: the Wacom PenPartner (USB\VID_056A&PID_0000). Other HID touch
; screens and pens: Update Driver, "Have Disk", this folder (design Q2).
; The Generic model's id matches no real device; it is the entry "Have
; Disk" offers for them.
; hidclass.sys and hidparse.sys are not copied: they are Microsoft's and
; come with the system's USB HID support, as for xpad98.
[Version]
Signature="$CHICAGO$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=11/06/2026,0.1.0.0

[Manufacturer]
%Provider%=Models

[Models]
%PenPartner%=ABSPTR,USB\VID_056A&PID_0000
%Generic%=ABSPTR,USB\VID_FFFF&PID_FFFF&REV_FFFF

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
absptr.sys=1

[DestinationDirs]
ABSPTR.Copy=10,system32\drivers

[ABSPTR]
CopyFiles=ABSPTR.Copy
AddReg=ABSPTR.AddReg

[ABSPTR.Copy]
absptr.sys

[ABSPTR.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,absptr.sys

[Strings]
Provider="usb-wdm-free"
Disk="absptr driver disk"
PenPartner="Wacom PenPartner tablet (absptr)"
Generic="HID touch screen or pen tablet (absptr)"
