[ABSPTR]
CopyFiles=ABSPTR.Copy
AddReg=ABSPTR.AddReg

[ABSPTR.Copy]
absptr.sys

[ABSPTR.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,absptr.sys

