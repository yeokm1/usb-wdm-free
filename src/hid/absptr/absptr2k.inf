; SPDX-License-Identifier: GPL-2.0-or-later
; absptr - Windows 2000 and XP (32-bit): absolute pointing devices Windows'
; own HID support does not map to the pointer (docs/design/absptr.md
; sections 1, 8).
; Copyright (C) 2026 Yeo Kheng Meng
;
; Only what Windows' own HID driver cannot use: the Wacom PenPartner
; (USB\VID_056A&PID_0000) and HID touch screens by id, each group with its
; source (design section 8). Absolute mice with a 16-bit 0..32767 range
; (QEMU's tablet and the like) work with Windows' own driver and are not
; listed. Other HID touch screens and pens, and absolute mice with 12-bit
; fields or a 0..65535 range: Update Driver, "Have Disk", this folder. The
; Generic model's id matches no real device; it is the entry "Have Disk"
; offers for them.
[Version]
Signature="$Windows NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=11/06/2026,0.1.0.0

[Manufacturer]
%Provider%=Models

[Models]
%PenPartner%=ABSPTR,USB\VID_056A&PID_0000
%Generic%=ABSPTR,USB\VID_FFFF&PID_FFFF&REV_FFFF
; ids begin: listed by the source named above each group (ids only;
; docs/design/absptr.md section 8)
; Linux v6.12 drivers/hid/hid-multitouch.c, mt_devices[]
; HID multi-touch screens (the HID Digitizer page)
