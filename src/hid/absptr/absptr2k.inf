[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
absptr.sys=1

[DestinationDirs]
ABSPTR.Copy=12

[ABSPTR.NT]
Include=input.inf
Needs=HID_Inst.NT
CopyFiles=ABSPTR.Copy

[ABSPTR.Copy]
absptr.sys

[ABSPTR.NT.Services]
AddService=absptr,0x00000002,ABSPTR.Service

[ABSPTR.Service]
DisplayName=%Service%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\absptr.sys

