[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
xpad98.sys=1

[DestinationDirs]
XPAD.Copy=12

[XPAD.NT]
Include=input.inf
Needs=HID_Inst.NT
CopyFiles=XPAD.Copy

[XPAD.Copy]
xpad98.sys

[XPAD.NT.Services]
AddService=xpad98,0x00000002,XPAD.Service

[XPAD.Service]
DisplayName=%Service%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\xpad98.sys

[Strings]
