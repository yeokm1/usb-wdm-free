# Expected decoding of strnonul.hex, written by hand from MTP 1.1, 5.3.1 and 3.2.3; 7.9 here and Q15 (not produced
# by the library or by simdev.c). Format: README.md.

parser = ObjectInfo
result = MTPE_OK (Q15, decided: accepted, with a trace line); trace has string-without-nul; the fields:
  StorageID = 00020001h
  ObjectFormat = 3004h
  ProtectionStatus = 8002h
  ObjectCompressedSize = 77116 (00012D3Ch)
  ThumbFormat = 3808h
  ThumbCompressedSize = 0031A1B1h
  ThumbPixWidth = 00320150h
  ThumbPixHeight = 003300E0h
  ImagePixWidth = 00340C80h
  ImagePixHeight = 00350960h
  ImageBitDepth = 00360010h
  ParentObject = 0001A2B3h
  AssociationType = 0000h (not an association)
  AssociationDesc = 0037C2D2h
  SequenceNumber = 0038E3F3h
  Filename = "abc" (terminated by the library)
  DateCreated = ""
  DateModified = ""
  Keywords = ""
end
