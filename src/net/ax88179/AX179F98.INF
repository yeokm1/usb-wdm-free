;
; AX179F98.INF - usb-wdm-free AX179F: ASIX AX88179 / AX88178A USB Gigabit
; Ethernet, Windows 98 SE and ME (ethernet.md sections 4.4, 7.1 and 7.4).
; NDIS.VXD loads the WDM miniport (DevLoader=*ndis, DeviceVxDs). A
; $Chicago$ INF is refused for Net on Windows 2000 (cdcnet's 2000 run),
; so AX179F.INF is the 2000 INF. Written from the Windows 2000 DDK network
; guide's INF pages and the Windows 98 DDK documentation; no DDK sample
; INF was read. The ids and the revision rule are AX179F.INF's.

[Version]
Signature="$Chicago$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/25/2026,0.1.1.0

[Manufacturer]
%Provider%=Models

[Models]
%Ax88179%=AX,USB\VID_0B95&PID_1790&REV_0100
%Ax88178a%=AX,USB\VID_0B95&PID_178A
%Gx3%=AX,USB\VID_04B4&PID_3610
%Dub1312%=AX,USB\VID_2001&PID_4A00
%Sitecom%=AX,USB\VID_0DF6&PID_0072
%Samsung%=AX,USB\VID_04E8&PID_A100
%Lenovo%=AX,USB\VID_17EF&PID_304B
%Belkin%=AX,USB\VID_050D&PID_0128
%Toshiba%=AX,USB\VID_0930&PID_0A13
%Mct%=AX,USB\VID_0711&PID_0179
%Umc2000%=AX,USB\VID_07C9&PID_000E
%Umc200%=AX,USB\VID_07C9&PID_000F
%Umc2000sp%=AX,USB\VID_07C9&PID_0010

[ControlFlags]
ExcludeFromSelect=*

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
ax179f.sys=1

[DestinationDirs]
Copy9x=11

[AX]
CopyFiles=Copy9x
AddReg=Reg9x,Params

[Copy9x]
ax179f.sys

[Reg9x]
HKR,,DevLoader,,*ndis
HKR,,DeviceVxDs,,ax179f.sys
HKR,,EnumPropPages,,"netdi.dll,EnumPropPages"
HKR,NDIS,LogDriverName,,AX179F
HKR,NDIS,MajorNdisVersion,1,05
HKR,NDIS,MinorNdisVersion,1,00
HKR,Ndi,DeviceID,,"USB\AX179F"
HKR,Ndi\Interfaces,DefUpper,,ndis3
HKR,Ndi\Interfaces,UpperRange,,"ndis3,ndis4,ndis5"
HKR,Ndi\Interfaces,DefLower,,ethernet
HKR,Ndi\Interfaces,LowerRange,,ethernet
HKR,Ndi\Install,ndis3,,AX.ndis
HKR,Ndi\Install,ndis4,,AX.ndis
HKR,Ndi\Install,ndis5,,AX.ndis

[AX.ndis]
CopyFiles=Copy9x

; The Advanced tab: a locally administered address (ethernet.md 4.8).
[Params]
HKR,Ndi\params\NetworkAddress,ParamDesc,,%AddressDesc%
HKR,Ndi\params\NetworkAddress,type,,edit
HKR,Ndi\params\NetworkAddress,LimitText,,12
HKR,Ndi\params\NetworkAddress,UpperCase,,1
HKR,Ndi\params\NetworkAddress,optional,,1
HKR,Ndi\params\NetworkAddress,default,,""

[Strings]
Provider="usb-wdm-free"
Disk="AX179F installation disk"
AddressDesc="Network Address"
Ax88179="ASIX AX88179 USB 3.0 Gigabit Ethernet (AX179F)"
Ax88178a="ASIX AX88178A USB 2.0 Gigabit Ethernet (AX179F)"
Gx3="Cypress GX3 SuperSpeed Gigabit Ethernet (AX179F)"
Dub1312="D-Link DUB-1312 USB 3.0 Gigabit Ethernet (AX179F)"
Sitecom="Sitecom USB 3.0 Gigabit Ethernet (AX179F)"
Samsung="Samsung USB Ethernet Adapter (AX179F)"
Lenovo="Lenovo OneLink Dock Gigabit LAN (AX179F)"
Belkin="Belkin B2B128 USB 3.0 Hub + Gigabit Ethernet (AX179F)"
Toshiba="Toshiba USB 3.0 Gigabit Ethernet (AX179F)"
Mct="Magic Control Technology U3-A9003 Gigabit Ethernet (AX179F)"
Umc2000="Allied Telesis AT-UMC2000 Gigabit Ethernet (AX179F)"
Umc200="Allied Telesis AT-UMC200 Fast Ethernet (AX179F)"
Umc2000sp="Allied Telesis AT-UMC2000/SP Gigabit Ethernet (AX179F)"
