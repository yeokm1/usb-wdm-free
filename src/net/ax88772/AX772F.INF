;
; AX772F.INF - usb-wdm-free AX772F, Windows 2000, XP, XP x64, Vista and 7,
; x86 and x64: the CoreChips SR9800 only (ethernet.md sections 6.9.1 and
; 7.6). No maker's driver serves the SR9800 on any Windows. The ASIX
; AX88772B and AX88772C, which this driver also runs, are not listed here:
; ASIX's own drivers in usb-wdm-nonfree serve them on 2000 and later, and
; one id is never listed by two INFs on one system. AX772F98.INF is the
; Windows 98 SE and ME INF. Written as RTLXP7.INF is (the Windows 2000 DDK
; network guide's INF pages; no DDK sample INF was read).
;
; Models: [Models] for 2000 (which ignores decorations), NTx86.5.1 and
; NTamd64.5.2 (XP, XP x64), NTx86.6.0 / NTamd64.6.0 (Vista), NTx86.6.1 /
; NTamd64.6.1 (7): 0FE6:9800 (Linux sr9800.c). NTx86.6.2 / NTamd64.6.2:
; none, Windows 8 and later have no NDIS 5 (ethernet.md section 4.1).

[Version]
Signature="$Windows NT$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=11/10/2026,0.1.1.0

[Manufacturer]
%Provider%=Models,NTx86.5.1,NTamd64.5.2,NTx86.6.0,NTamd64.6.0,NTx86.6.1,NTamd64.6.1,NTx86.6.2,NTamd64.6.2

[Models]
%Sr9800%=AX_SR,USB\VID_0FE6&PID_9800

[Models.NTx86.5.1]
%Sr9800%=AX_SR,USB\VID_0FE6&PID_9800

[Models.NTamd64.5.2]
%Sr9800%=AX_SR,USB\VID_0FE6&PID_9800

[Models.NTx86.6.0]
%Sr9800%=AX_SR,USB\VID_0FE6&PID_9800

[Models.NTamd64.6.0]
%Sr9800%=AX_SR,USB\VID_0FE6&PID_9800

[Models.NTx86.6.1]
%Sr9800%=AX_SR,USB\VID_0FE6&PID_9800

[Models.NTamd64.6.1]
%Sr9800%=AX_SR,USB\VID_0FE6&PID_9800

[Models.NTx86.6.2]

[Models.NTamd64.6.2]

[ControlFlags]
ExcludeFromSelect=*

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
ax772f.sys=1

[DestinationDirs]
CopyNT=12

[AX_SR.NT]
Characteristics=0x84
BusType=15
CopyFiles=CopyNT
AddReg=RegNT,Params,Speed
*IfType=6
*MediaType=0
*PhysicalMediaType=14

[AX_SR.NTamd64]
Characteristics=0x84
BusType=15
CopyFiles=CopyNT
AddReg=RegNT,Params,Speed
*IfType=6
*MediaType=0
*PhysicalMediaType=14

[CopyNT]
ax772f.sys

[RegNT]
HKR,Ndi,Service,,ax772f
HKR,Ndi\Interfaces,UpperRange,,ndis5
HKR,Ndi\Interfaces,LowerRange,,ethernet

[AX_SR.NT.Services]
AddService=ax772f,2,Service,EventLog

[AX_SR.NTamd64.Services]
AddService=ax772f,2,Service,EventLog

[Service]
DisplayName=%Service%
ServiceType=1
StartType=3
ErrorControl=1
LoadOrderGroup=NDIS
ServiceBinary=%12%\ax772f.sys

[EventLog]
AddReg=EventLogReg

[EventLogReg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\netevent.dll"
HKR,,TypesSupported,0x00010001,7

; The Advanced tab (ethernet.md section 4.10): ASIX's AX88772B 7 INF's
; keywords, values and defaults for the AX88772B and AX88772C, each written
; to the driver key at its default (no-clobber, so a reinstall keeps a
; changed value); the SR9800, which no maker's INF covers, speed and duplex
; only (a clause 22 MII PHY).
; The locally administered address (ethernet.md 4.8).
[Params]
HKR,Ndi\params\NetworkAddress,ParamDesc,,%AddressDesc%
HKR,Ndi\params\NetworkAddress,type,,edit
HKR,Ndi\params\NetworkAddress,LimitText,,12
HKR,Ndi\params\NetworkAddress,UpperCase,,1
HKR,Ndi\params\NetworkAddress,optional,,1
HKR,Ndi\params\NetworkAddress,default,,""

[Speed]
HKR,Ndi\params\*SpeedDuplex,ParamDesc,,%SpeedDesc%
HKR,Ndi\params\*SpeedDuplex,type,,enum
HKR,Ndi\params\*SpeedDuplex,default,,0
HKR,Ndi\params\*SpeedDuplex\enum,0,,%Auto%
HKR,Ndi\params\*SpeedDuplex\enum,1,,%S10H%
HKR,Ndi\params\*SpeedDuplex\enum,2,,%S10F%
HKR,Ndi\params\*SpeedDuplex\enum,3,,%S100H%
HKR,Ndi\params\*SpeedDuplex\enum,4,,%S100F%
HKR,,*SpeedDuplex,0x00000002,"0"

[Strings]
Provider="usb-wdm-free"
Disk="AX772F installation disk"
Service="usb-wdm-free AX772F USB Fast Ethernet"
AddressDesc="Network Address"
SpeedDesc="Speed and duplex"
Auto="Automatic"
S10H="10 Mb/s half duplex"
S10F="10 Mb/s full duplex"
S100H="100 Mb/s half duplex"
S100F="100 Mb/s full duplex"
S1000F="1 Gb/s full duplex"
FlowDesc="Flow control"
Off="Off"
On="On"
TxOnly="Transmit only"
RxOnly="Receive only"
RxTx="Transmit and receive"
EeeDesc="Energy-Efficient Ethernet (EEE)"
Sr9800="CoreChips SR9800 USB 2.0 Fast Ethernet (AX772F)"
