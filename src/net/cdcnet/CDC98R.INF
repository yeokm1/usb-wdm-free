;
; CDC98R.INF - TEST ONLY (RNDIS preset), never released; generated by gentest.py from
; CDC98.INF. Binds CDCNET to QEMU's usb-net model, USB\VID_0525&PID_A4A2,
; as a whole device (RNDIS configuration 2 listed first, ECM
; configuration 1). ethernet.md section 5.1: a shared gadget VID/PID
; never goes in a released INF.

[Version]
Signature="$Chicago$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/24/2026,0.1.0.0

[Manufacturer]
%Provider%=Models

[Models]
%Test%=CDC,USB\VID_0525&PID_A4A2

[ControlFlags]
ExcludeFromSelect=*

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
cdcnet.sys=1

[DestinationDirs]
Copy9x=11

; ---- Windows 98 SE and ME: NDIS.VXD loads the WDM miniport ----

[CDC]
CopyFiles=Copy9x
AddReg=Reg9x,Params

[Copy9x]
cdcnet.sys

[Reg9x]
HKR,,DevLoader,,*ndis
HKR,,DeviceVxDs,,cdcnet.sys
HKR,,EnumPropPages,,"netdi.dll,EnumPropPages"
HKR,NDIS,LogDriverName,,CDCNET
HKR,NDIS,MajorNdisVersion,1,05
HKR,NDIS,MinorNdisVersion,1,00
HKR,Ndi,DeviceID,,"USB\CDCNET"
HKR,Ndi\Interfaces,DefUpper,,ndis3
HKR,Ndi\Interfaces,UpperRange,,"ndis3,ndis4,ndis5"
HKR,Ndi\Interfaces,DefLower,,ethernet
HKR,Ndi\Interfaces,LowerRange,,ethernet
HKR,Ndi\Install,ndis3,,CDC.ndis
HKR,Ndi\Install,ndis4,,CDC.ndis
HKR,Ndi\Install,ndis5,,CDC.ndis

[CDC.ndis]
CopyFiles=Copy9x

; The Advanced tab: which protocol to prefer when a device offers several.
[Params]
HKR,Ndi\params\Protocol,ParamDesc,,%ProtocolDesc%
HKR,Ndi\params\Protocol,type,,enum
HKR,Ndi\params\Protocol,default,,1
HKR,Ndi\params\Protocol\enum,0,,%Auto%
HKR,Ndi\params\Protocol\enum,1,,%ForceRndis%
HKR,Ndi\params\Protocol\enum,2,,%ForceEcm%
HKR,Ndi\params\Protocol\enum,3,,%ForceNcm%
HKR,,Protocol,,1

[Strings]
Test="CDCNET RNDIS test: QEMU usb-net (not a release)"
Provider="usb-wdm-free"
Disk="CDCNET installation disk"
Ecm="USB Ethernet (CDC-ECM)"
Ncm="USB Ethernet (CDC-NCM)"
Rndis="USB Ethernet (RNDIS)"
Rtl8153="Realtek RTL8153 USB Ethernet (CDC-ECM mode)"
Service="usb-wdm-free CDCNET USB Ethernet"
ProtocolDesc="USB protocol"
Auto="Automatic (NCM, ECM, RNDIS)"
ForceRndis="RNDIS only"
ForceEcm="CDC-ECM only"
ForceNcm="CDC-NCM only"
