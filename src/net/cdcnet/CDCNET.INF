;
; CDCNET.INF - usb-wdm-free USB Ethernet: CDC-ECM, CDC-NCM and RNDIS.
; Windows 2000 to 7 (ethernet.md sections 5.1 and 7); CDC98.INF is the
; Windows 98 SE and ME INF.
; Written from the Windows 2000 DDK network guide's INF pages and the
; Windows 98 DDK documentation; no DDK sample INF was read.
;
; Models:
;   [Models]              2000 (which ignores decorations):
;                         ECM, NCM, the four RNDIS class triples.
;   [Models.NTx86.5.1]    XP to 7 x86: ECM, NCM. RNDIS there is
;   [Models.NTamd64]      Windows' own driver through CDCRNDIS.INF.
; Interface-level class ids, and in every models section one whole-device
; id (ethernet.md section 5.1): USB\VID_0525&PID_A4A2, the Linux Ethernet
; gadget's default id and QEMU usb-net's, a device of class 02 with no
; interface split, bound whole to the same CDC install sections as
; CDCTEST.INF binds it. The RTL8153's 0BDA:8153 is no longer
; listed (owner, 2026-10-24; ethernet.md 6.5): one INF per id per system
; across xHCI98's free and non-free sets.

[Version]
Signature="$Windows NT$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/24/2026,0.1.0.0

[Manufacturer]
%Provider%=Models,NTx86.5.1,NTamd64

[Models]
%Ecm%=CDC,USB\Class_02&SubClass_06&Prot_00
%Ncm%=CDC,USB\Class_02&SubClass_0D&Prot_00
%Rndis%=CDC,USB\Class_02&SubClass_02&Prot_FF
%Rndis%=CDC,USB\Class_E0&SubClass_01&Prot_03
%Rndis%=CDC,USB\Class_EF&SubClass_01&Prot_01
%Rndis%=CDC,USB\Class_EF&SubClass_04&Prot_01
%Gadget%=CDC,USB\VID_0525&PID_A4A2

[Models.NTx86.5.1]
%Ecm%=CDC,USB\Class_02&SubClass_06&Prot_00
%Ncm%=CDC,USB\Class_02&SubClass_0D&Prot_00
%Gadget%=CDC,USB\VID_0525&PID_A4A2

[Models.NTamd64]
%Ecm%=CDC,USB\Class_02&SubClass_06&Prot_00
%Ncm%=CDC,USB\Class_02&SubClass_0D&Prot_00
%Gadget%=CDC,USB\VID_0525&PID_A4A2

[ControlFlags]
ExcludeFromSelect=*

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
cdcnet.sys=1

[DestinationDirs]
CopyNT=12

; ---- Windows 2000 to 7 ----

[CDC.NT]
Characteristics=0x84
BusType=15
CopyFiles=CopyNT
AddReg=RegNT,Params
*IfType=6
*MediaType=0
*PhysicalMediaType=14

[CDC.NTamd64]
Characteristics=0x84
BusType=15
CopyFiles=CopyNT
AddReg=RegNT,Params
*IfType=6
*MediaType=0
*PhysicalMediaType=14

[CopyNT]
cdcnet.sys

[RegNT]
HKR,Ndi,Service,,cdcnet
HKR,Ndi\Interfaces,UpperRange,,ndis5
HKR,Ndi\Interfaces,LowerRange,,ethernet

[CDC.NT.Services]
AddService=cdcnet,2,Service,EventLog

[CDC.NTamd64.Services]
AddService=cdcnet,2,Service,EventLog

[Service]
DisplayName=%Service%
ServiceType=1
StartType=3
ErrorControl=1
LoadOrderGroup=NDIS
ServiceBinary=%12%\cdcnet.sys

[EventLog]
AddReg=EventLogReg

[EventLogReg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\netevent.dll"
HKR,,TypesSupported,0x00010001,7

; The Advanced tab: which protocol to prefer when a device offers several.
[Params]
HKR,Ndi\params\Protocol,ParamDesc,,%ProtocolDesc%
HKR,Ndi\params\Protocol,type,,enum
HKR,Ndi\params\Protocol,default,,0
HKR,Ndi\params\Protocol\enum,0,,%Auto%
HKR,Ndi\params\Protocol\enum,1,,%ForceRndis%
HKR,Ndi\params\Protocol\enum,2,,%ForceEcm%
HKR,Ndi\params\Protocol\enum,3,,%ForceNcm%
HKR,,Protocol,,0

[Strings]
Provider="usb-wdm-free"
Disk="CDCNET installation disk"
Ecm="USB Ethernet (CDC-ECM)"
Ncm="USB Ethernet (CDC-NCM)"
Rndis="USB Ethernet (RNDIS)"
Gadget="USB Ethernet (Linux USB gadget)"
Service="usb-wdm-free CDCNET USB Ethernet"
ProtocolDesc="USB protocol"
Auto="Automatic (NCM, ECM, RNDIS)"
ForceRndis="RNDIS only"
ForceEcm="CDC-ECM only"
ForceNcm="CDC-NCM only"
