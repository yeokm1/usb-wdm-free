;
; CDCTEST.INF - TEST ONLY, never released; generated by gentest.py from
; CDCNET.INF. Binds CDCNET to QEMU's usb-net model, USB\VID_0525&PID_A4A2,
; as a whole device (RNDIS configuration 2 listed first, ECM
; configuration 1). ethernet.md section 5.1: a shared gadget VID/PID
; never goes in a released INF.

[Version]
Signature="$Windows NT$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/22/2026,0.1.0.0

[Manufacturer]
%Provider%=Models,NTx86.5.1,NTamd64

[Models]
%Test%=CDC,USB\VID_0525&PID_A4A2

[Models.NTx86.5.1]
%Test%=CDC,USB\VID_0525&PID_A4A2

[Models.NTamd64]
%Test%=CDC,USB\VID_0525&PID_A4A2

[ControlFlags]
ExcludeFromSelect=*

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
cdcnet.sys=1

[DestinationDirs]
CopyNT=12

; ---- Windows 2000 to 7 ----

[CDC.NT]
Characteristics=0x84
BusType=15
CopyFiles=CopyNT
AddReg=RegNT,Params
*IfType=6
*MediaType=0
*PhysicalMediaType=14

[CDC.NTamd64]
Characteristics=0x84
BusType=15
CopyFiles=CopyNT
AddReg=RegNT,Params
*IfType=6
*MediaType=0
*PhysicalMediaType=14

[CopyNT]
cdcnet.sys

[RegNT]
HKR,Ndi,Service,,cdcnet
HKR,Ndi\Interfaces,UpperRange,,ndis5
HKR,Ndi\Interfaces,LowerRange,,ethernet

[CDC.NT.Services]
AddService=cdcnet,2,Service,EventLog

[CDC.NTamd64.Services]
AddService=cdcnet,2,Service,EventLog

[Service]
DisplayName=%Service%
ServiceType=1
StartType=3
ErrorControl=1
LoadOrderGroup=NDIS
ServiceBinary=%12%\cdcnet.sys

[EventLog]
AddReg=EventLogReg

[EventLogReg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\netevent.dll"
HKR,,TypesSupported,0x00010001,7

; The Advanced tab: which protocol to prefer when a device offers several.
[Params]
HKR,Ndi\params\Protocol,ParamDesc,,%ProtocolDesc%
HKR,Ndi\params\Protocol,type,,enum
HKR,Ndi\params\Protocol,default,,0
HKR,Ndi\params\Protocol\enum,0,,%Auto%
HKR,Ndi\params\Protocol\enum,1,,%ForceRndis%
HKR,Ndi\params\Protocol\enum,2,,%ForceEcm%
HKR,Ndi\params\Protocol\enum,3,,%ForceNcm%
HKR,,Protocol,,0

[Strings]
Test="CDCNET test: QEMU usb-net (not a release)"
Provider="usb-wdm-free"
Disk="CDCNET installation disk"
Ecm="USB Ethernet (CDC-ECM)"
Ncm="USB Ethernet (CDC-NCM)"
Rndis="USB Ethernet (RNDIS)"
Rtl8153="Realtek RTL8153 USB Ethernet (CDC-ECM mode)"
Service="usb-wdm-free CDCNET USB Ethernet"
ProtocolDesc="USB protocol"
Auto="Automatic (NCM, ECM, RNDIS)"
ForceRndis="RNDIS only"
ForceEcm="CDC-ECM only"
ForceNcm="CDC-NCM only"
