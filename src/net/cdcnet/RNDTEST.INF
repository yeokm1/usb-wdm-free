;
; RNDTEST.INF - TEST ONLY, never released; generated by gentest.py from
; CDCRNDIS.INF. Binds Windows' own RNDIS driver to QEMU's usb-net model, USB\VID_0525&PID_A4A2,
; as a whole device (RNDIS configuration 2 listed first, ECM
; configuration 1). ethernet.md section 5.1: a shared gadget VID/PID
; never goes in a released INF.

[Version]
Signature="$Windows NT$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/22/2026,0.1.0.0

[Manufacturer]
%Provider%=Models,NTx86.5.1,NTx86.6.0,NTx86.6.1,NTamd64,NTamd64.6.0,NTamd64.6.1

[Models.NTx86.5.1]
%Test%=Rndis5,USB\VID_0525&PID_A4A2

[Models.NTx86.6.0]
%Test%=Rndis5,USB\VID_0525&PID_A4A2

[Models.NTx86.6.1]
%Test%=Rndis6,USB\VID_0525&PID_A4A2

[Models.NTamd64]
%Test%=Rndis5,USB\VID_0525&PID_A4A2

[Models.NTamd64.6.0]
%Test%=Rndis5,USB\VID_0525&PID_A4A2

[Models.NTamd64.6.1]
%Test%=Rndis6,USB\VID_0525&PID_A4A2

[ControlFlags]
ExcludeFromSelect=*

; XP, XP x64 and Vista: the NDIS 5 RNDIS miniport.
[Rndis5]
Characteristics=0x84
BusType=15
Include=netrndis.inf
Needs=usb_rndis.ndi

[Rndis5.Services]
Include=netrndis.inf
Needs=usb_rndis.ndi.Services

; 7: the NDIS 6 RNDIS miniport.
[Rndis6]
Characteristics=0x84
BusType=15
Include=netrndis.inf
Needs=usbrndis6.ndi
*IfType=6
*MediaType=0
*PhysicalMediaType=14

[Rndis6.Services]
Include=netrndis.inf
Needs=usbrndis6.ndi.Services

[Strings]
Test="CDCRNDIS test: QEMU usb-net on the Windows RNDIS driver (not a release)"
Provider="usb-wdm-free"
Rndis="USB Ethernet (RNDIS, Windows driver)"
