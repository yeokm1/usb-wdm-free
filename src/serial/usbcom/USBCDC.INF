[ACM.NT]
Include=mdmcpq.inf
CopyFiles=FakeModemCopyFileSection

[ACM.NT.Services]
AddService=usbser,0x00000002,SerialService

[SerialService]
DisplayName=%Service%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\usbser.sys

