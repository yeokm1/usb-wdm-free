; Release 0.1.0, for ME only. Copy the two parent drivers from ME's own
; layout/media; no Microsoft file is included with this package. ME's
; USBNTMAP.INF supplies USBMPHLP.PDR when it installs the floppy child.
[Version]
Signature="$CHICAGO$"
Class=USB
ClassGuid={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
LayoutFile=layout.inf,layout1.inf,layout2.inf
DriverVer=10/24/2026,0.1.0.0

[Manufacturer]
%Provider%=Models

[Models]
%CBI%=UFI_CBI,USB\Class_08&SubClass_04&Prot_00
%CB%=UFI_CB,USB\Class_08&SubClass_04&Prot_01

[UFI_CBI]
CopyFiles=Storage.Copy
AddReg=Loader,CBI.Flags

[UFI_CBI.HW]
AddReg=Mapper

[UFI_CB]
CopyFiles=Storage.Copy
AddReg=Loader,CB.Flags

[UFI_CB.HW]
AddReg=Mapper

[DestinationDirs]
Storage.Copy=10,system32\drivers

[Storage.Copy]
USBSTOR.SYS
USBNTMAP.SYS

[Loader]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,USBSTOR.SYS

[Mapper]
HKR,,upperfilters,0,"USBNTMAP.SYS"

[CBI.Flags]
HKR,,DriverFlags,0x00010001,2

[CB.Flags]
HKR,,DriverFlags,0x00010001,3

[Strings]
Provider="usb-wdm-free"
CBI="USB UFI floppy (CBI, usb-wdm-free)"
CB="USB UFI floppy (CB, usb-wdm-free)"
